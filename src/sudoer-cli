sr_fence_test_fid() {
    _ft_bn=$(basename -- "${1-}")
    case "${_ft_bn}" in
        sudoer-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-*.json)
            printf '%s' "${_ft_bn}"
            ;;
        *)
            printf '%s' ""
            ;;
    esac
}

# Run the closed dest fence list (JSON format, then well-known binary). Dies on match.
sr_fence_test_apply() {
    _ft_body="$1"
    _ft_fid="$2"
    _cmd=$(sr_test_purpose_cmd)
    _next="${_cmd} fence-test --file request.json"
    sr_json_format_fence_or_die "${_ft_body}" "${_next}" "test" "${_ft_fid}"
    _ft_act="${SR_D_ACT:-}"
    if [ -n "${_ft_fid}" ] && [ -z "${_ft_act}" ]; then
        _ft_act="${SR_ID_ACT}"
    fi
    if [ "${_ft_act}" != "remove" ]; then
        sr_cmds_require_well_known "${SR_D_CMDS}" "test" "${_next}"
    fi
}

sr_fence_test() {
    _cmd=$(sr_test_purpose_cmd)
    if [ -n "${SR_DIR-}" ] && [ -n "${SR_FILE-}" ]; then
        sr_die "fence-test takes --file PATH or --dir DIR or stdin, not both --file and --dir." "xor_input" \
            "${_cmd} fence-test --file request.json"
    fi
    if [ -n "${SR_DIR-}" ]; then
        sr_fence_test_dir
        return 0
    fi
    if [ "${SR_EXPECT_MATCH:-0}" = "1" ]; then
        sr_die "--expect-match is only valid with --dir DIR." "xor_input" \
            "${_cmd} fence-test --dir tests/fixtures/fence-test/match --expect-match"
    fi
    _raw=$(sr_read_input)
    _fid=""
    if [ -n "${SR_FILE-}" ]; then
        _fid=$(sr_fence_test_fid "${SR_FILE}")
    fi
    sr_fence_test_apply "${_raw}" "${_fid}"
    if [ "${JSON}" -eq 1 ]; then
        out_json "success" "No dest fence matched." \
            "command" "fence-test" \
            "username" "${SR_D_USER}" \
            "service" "${SR_D_SVC}" \
            "action" "${SR_D_ACT}"
    else
        out_success "No dest fence matched."
    fi
}

sr_fence_test_dir() {
    _dir="${SR_DIR}"
    _cmd=$(sr_test_purpose_cmd)
    [ -n "${_dir}" ] || sr_die "fence-test --dir requires DIR." "xor_input" \
        "${_cmd} fence-test --dir tests/fixtures/fence-test/pass"
    [ -d "${_dir}" ] || sr_die "fence-test --dir is not a directory: ${_dir}" "not_found" \
        "${_cmd} fence-test --dir tests/fixtures/fence-test/pass"
    [ -L "${_dir}" ] && sr_die "fence-test refuses a symlink --dir: ${_dir}" "not_regular" \
        "${_cmd} fence-test --dir tests/fixtures/fence-test/pass"
    _expect="${SR_EXPECT_MATCH:-0}"
    _n=0
    _matched=0
    _passed=0
    for _fp in "${_dir}"/*.json; do
        [ -f "${_fp}" ] || continue
        [ -L "${_fp}" ] && continue
        _bn=$(basename -- "${_fp}")
        _n=$((_n + 1))
        if ( sr_fence_test_apply "$(cat "${_fp}")" "$(sr_fence_test_fid "${_fp}")" ); then
            _passed=$((_passed + 1))
            out_info "pass ${_bn}"
        else
            _matched=$((_matched + 1))
            out_info "fence-matched ${_bn}"
        fi
    done
    if [ "${_n}" -eq 0 ]; then
        sr_die "fence-test --dir has no regular .json files: ${_dir}" "not_found" \
            "${_cmd} fence-test --file request.json"
    fi
    if [ "${_expect}" = "1" ]; then
        if [ "${_passed}" -ne 0 ] || [ "${_matched}" -ne "${_n}" ]; then
            sr_die "fence-test --expect-match: ${_passed} of ${_n} files had no dest fence (want every file to match)." "invalid_json" \
                "${_cmd} fence-test --dir ${_dir} --expect-match"
        fi
        if [ "${JSON}" -eq 1 ]; then
            out_json "success" "fence-test: ${_n} files, all matched a dest fence." \
                "command" "fence-test" \
                "files" "${_n}" \
                "matched" "${_matched}" \
                "passed" "${_passed}" \
                "expect_match" "1"
        else
            out_success "fence-test: ${_n} files, all matched a dest fence."
        fi
        return 0
    fi
    if [ "${_matched}" -ne 0 ]; then
        sr_die "fence-test: ${_matched} of ${_n} files matched a dest fence." "invalid_json" \
            "${_cmd} fence-test --file request.json"
    fi
    if [ "${JSON}" -eq 1 ]; then
        out_json "success" "fence-test: ${_n} files, no dest fence matched." \
            "command" "fence-test" \
            "files" "${_n}" \
            "matched" "0" \
            "passed" "${_passed}"
    else
        out_success "fence-test: ${_n} files, no dest fence matched."
    fi
}

sr_approve() {
    sr_require_type1
    sr_require_queues
    sr_require_approver_views
    _id="${SR_OPERAND-}"
    [ -n "${_id}" ] || sr_die "approve requires request-id" "not_found"
    _in=$(sr_approver_dir request)
    _ok=$(sr_approver_dir approved)
    _path="${_in}/${_id}"
    [ -f "${_path}" ] || sr_die "not in request queue: ${_id}" "not_found"
    sr_dest_fence_or_die "${_path}" "${_id}"
    sr_dest_review_warn
    _priv=$(mktemp "${TMPDIR:-/tmp}/sr-apr.XXXXXX")
    if ! cp "${_path}" "${_priv}"; then
        rm -f "${_priv}"
        sr_die "cannot snapshot ${_id}" "authz"
    fi
    _body=$(cat "${_priv}")
    sr_json_decode_to_fields "${_body}"
    sr_parse_request_id "${_id}"
    _user="${SR_D_USER:-${SR_ID_USER}}"
    _svc="${SR_D_SVC:-${SR_ID_SVC}}"
    _act="${SR_D_ACT:-${SR_ID_ACT}}"
    if [ -n "${SR_D_ACT}" ] && [ "${SR_D_ACT}" != "${SR_ID_ACT}" ]; then
        rm -f "${_priv}"
        sr_die "This waiting file's name says ${SR_ID_ACT} but the JSON action is ${SR_D_ACT}. Dest will not ask yes/no. Do not approve it." "field_mismatch" \
            "$(sr_operator_cmd) add-sudoer-request --file request.json"
    fi
    [ -n "${_user}" ] || sr_die "username required" "invalid_json"
    [ -n "${_svc}" ] || sr_die "service required" "unknown_service"
    sr_rewrite_login_hook_elev_cmds
    _dest=$(sr_grant_dest "${_user}" "${_svc}")
    sr_forbid_passwd_or_main_sudoers "${_dest}"
    sr_require_product_sudoers_d "${_dest}"
    _dest_dir=$(sr_sudoers_d_dir)
    if [ "${_act}" = "remove" ]; then
        if [ -f "${_dest}" ]; then
            if [ "${SUDOER_CLI_ALLOW_TEST_ROOTS:-0}" = "1" ]; then
                _bak="${_dest_dir}/.bak"
            else
                _bak="/etc/sudoers.bak"
            fi
            mkdir -p "${_bak}"
            mv "${_dest}" "${_bak}/$(basename "${_dest}").bak" 2>/dev/null || rm -f "${_dest}"
        fi
    else
        _txt=$(sr_render_sudoers "${SR_D_PURPOSE}" "${_user}" "${_act}" "${SR_D_CMDS}")
        sr_visudo_text "${_txt}"
        mkdir -p "${_dest_dir}"
        printf '%s\n' "${_txt}" >"${_dest}"
    fi
    sr_archive_validated "${_priv}" "${_ok}" "${_id}" "${_path}"
    if [ "${JSON}" -eq 1 ]; then
        out_json "success" "approved" "request_id" "${_id}" "dest" "${_dest}"
    else
        out_success "approved ${_id}"
    fi
}

sr_reject() {
    sr_require_type1
    sr_require_queues
    sr_require_approver_views
    _id="${SR_OPERAND-}"
    [ -n "${_id}" ] || sr_die "reject requires request-id" "not_found"
    _in=$(sr_approver_dir request)
    _no=$(sr_approver_dir rejected)
    _path="${_in}/${_id}"
    [ -f "${_path}" ] || sr_die "not in request queue: ${_id}" "not_found"
    sr_dest_fence_or_die "${_path}" "${_id}"
    _priv=$(mktemp "${TMPDIR:-/tmp}/sr-rej.XXXXXX")
    if ! cp "${_path}" "${_priv}"; then
        rm -f "${_priv}"
        sr_die "cannot snapshot ${_id}" "authz"
    fi
    sr_archive_validated "${_priv}" "${_no}" "${_id}" "${_path}"
    if [ "${JSON}" -eq 1 ]; then
        out_json "success" "rejected" "request_id" "${_id}"
    else
        out_success "rejected ${_id}"
    fi
}

# Dest identity for duplicate inbound collapse: JSON username + service.
# ALIGNMENT: requirement-domain-sudoer-approval.md
sr_inbound_dest_key() {
    _dkf="$1"
    if [ ! -f "${_dkf}" ] || [ -L "${_dkf}" ]; then
        return 1
    fi
    _dkb=$(cat "${_dkf}" 2>/dev/null) || return 1
    _dku=$(sr_json_get_str "${_dkb}" "username")
    _dks=$(sr_json_get_str "${_dkb}" "service")
    if [ -z "${_dku}" ] || [ -z "${_dks}" ]; then
        return 1
    fi
    printf '%s|%s' "${_dku}" "${_dks}"
}

# 0 when $1 is later than $2 (newer mtime; equal mtime → later basename).
sr_inbound_is_later() {
    _la="$1"
    _lb="$2"
    if [ "${_la}" -nt "${_lb}" ]; then
        return 0
    fi
    if [ "${_lb}" -nt "${_la}" ]; then
        return 1
    fi
    _lba=$(basename "${_la}")
    _lbb=$(basename "${_lb}")
    [ "${_lba}" \> "${_lbb}" ]
}

# Older duplicate: snapshot inbound → rejected. No dest-write. No submit_by. No yes/no.
# ALIGNMENT: requirement-domain-sudoer-approval.md
sr_archive_superseded_rejected() {
    _sp="$1"
    _sid="$2"
    _kept="$3"
    _no=$(sr_approver_dir rejected)
    _priv=$(mktemp "${TMPDIR:-/tmp}/sr-super.XXXXXX")
    if ! cp "${_sp}" "${_priv}"; then
        rm -f "${_priv}"
        sr_die "cannot snapshot superseded ${_sid}" "authz"
    fi
    sr_archive_validated "${_priv}" "${_no}" "${_sid}" "${_sp}"
    out_info "superseded ${_sid} (kept ${_kept})"
}

sr_drop_superseded_inbound() {
    _din="$1"
    _old="$2"
    _kept="$3"
    if [ ! -f "${_din}/${_old}" ]; then
        return 0
    fi
    if [ "$(id -u)" -eq 0 ]; then
        sr_chown_request_to_lpu "${_din}/${_old}"
    fi
    sr_archive_superseded_rejected "${_din}/${_old}" "${_old}" "${_kept}"
}

# Keep the latest inbound file per dest identity. Move older duplicates to rejected.
# Not a dest Fence. Standalone approve/reject of a remaining id stay non-interactive.
# ALIGNMENT: requirement-domain-sudoer-approval.md
sr_collapse_duplicate_inbound() {
    _cin="$1"
    _pairs=$(mktemp "${TMPDIR:-/tmp}/sr-dup.XXXXXX")
    for _cf in "${_cin}"/sudoer-*.json; do
        [ -f "${_cf}" ] || continue
        if [ -L "${_cf}" ]; then
            continue
        fi
        _cbn=$(basename "${_cf}")
        case "${_cbn}" in
            sudoer-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-*.json) ;;
            *) continue ;;
        esac
        _ck=$(sr_inbound_dest_key "${_cf}") || continue
        printf '%s\t%s\n' "${_cbn}" "${_ck}" >>"${_pairs}"
    done
    if [ ! -s "${_pairs}" ]; then
        rm -f "${_pairs}"
        return 0
    fi
    _keys=$(mktemp "${TMPDIR:-/tmp}/sr-dupk.XXXXXX")
    cut -f2 "${_pairs}" | sort -u >"${_keys}"
    while IFS= read -r _ckey || [ -n "${_ckey}" ]; do
        [ -n "${_ckey}" ] || continue
        _keep=""
        while IFS= read -r _cline || [ -n "${_cline}" ]; do
            [ -n "${_cline}" ] || continue
            _cbn="${_cline%%	*}"
            _ckk="${_cline#*	}"
            [ "${_ckk}" = "${_ckey}" ] || continue
            if [ -z "${_keep}" ]; then
                _keep="${_cbn}"
                continue
            fi
            if sr_inbound_is_later "${_cin}/${_cbn}" "${_cin}/${_keep}"; then
                if ! ( sr_drop_superseded_inbound "${_cin}" "${_keep}" "${_cbn}" ); then
                    out_error "could not move superseded ${_keep} to rejected; continuing"
                fi
                _keep="${_cbn}"
            else
                if ! ( sr_drop_superseded_inbound "${_cin}" "${_cbn}" "${_keep}" ); then
                    out_error "could not move superseded ${_cbn} to rejected; continuing"
                fi
            fi
        done <"${_pairs}"
    done <"${_keys}"
    rm -f "${_pairs}" "${_keys}"
}

# Interactive fence match: display already happened. Drain inbound → rejected
# without dest-write, without submit_by, without standalone reject re-validate.
# ALIGNMENT: requirement-incorrect-json-format.md · requirement-domain-sudoer-approval.md
sr_archive_fenced_rejected() {
    _fp="$1"
    _fid="$2"
    _no=$(sr_approver_dir rejected)
    _priv=$(mktemp "${TMPDIR:-/tmp}/sr-fence.XXXXXX")
    if ! cp "${_fp}" "${_priv}"; then
        rm -f "${_priv}"
        sr_die "cannot snapshot fenced ${_fid}" "authz"
    fi
    sr_archive_validated "${_priv}" "${_no}" "${_fid}" "${_fp}"
    if [ "${JSON}" -eq 1 ]; then
        out_json "success" "rejected" "request_id" "${_fid}" "reason" "fence"
    else
        out_success "rejected ${_fid}"
    fi
}

# =============================================================================
# sr_yaml_scalar() - YAML scalar for login-hook review display
# =============================================================================
#
# GENERAL PURPOSE:
# Quote a decoded JSON string as a YAML scalar. Simple tokens stay unquoted;
# anything else is a double-quoted YAML string (JSON-style escapes).
# Class B helper: printf return, not a product message.
#
# ALIGNMENT:
# - requirement-domain-sudoer-approval.md
#
# Last updated: 2026-09-06
# =============================================================================
sr_yaml_scalar() {
    _ys="${1-}"
    case "${_ys}" in
        ""|*[!A-Za-z0-9._/@+-]*)
            printf '"%s"' "$(util_json_escape "${_ys}")"
            ;;
        *)
            printf '%s' "${_ys}"
            ;;
    esac
}

# =============================================================================
# sr_yaml_line() - One two-space-indented YAML line on the review TTY
# =============================================================================
#
# GENERAL PURPOSE:
# Print one login-hook / interactive review line with two-space group indent
# so each request body reads as a block under [INFO] Request {id}. Nested
# YAML indent stays in the payload. Product messages still go through out_*.
#
# ALIGNMENT:
# - requirement-domain-sudoer-approval.md
# - requirement-shell-output-requirements.md
#
# Last updated: 2026-09-08
# =============================================================================
sr_yaml_line() {
    out_plain "  $*"
}

# =============================================================================
# sr_yaml_kv() - One YAML key: value line on the review TTY
# =============================================================================
#
# GENERAL PURPOSE:
# Print one mapping line through sr_yaml_line for the login-hook review body.
#
# ALIGNMENT:
# - requirement-domain-sudoer-approval.md
# - requirement-shell-output-requirements.md
#
# Last updated: 2026-09-08
# =============================================================================
sr_yaml_kv() {
    _yk="$1"
    _yv="${2-}"
    _ysc=$(sr_yaml_scalar "${_yv}")
    sr_yaml_line "${_yk}: ${_ysc}"
}

# =============================================================================
# sr_print_review_yaml() - Human YAML body of a decoded inbound grant
# =============================================================================
#
# GENERAL PURPOSE:
# Login-hook / interactive review shows YAML for readability, indented two
# spaces so each request groups under [INFO] Request {id}. The waiting file
# stays JSON. Type 0 show still dumps that JSON file. Not a dest Fence.
#
# ALIGNMENT:
# - requirement-domain-sudoer-approval.md
#
# Last updated: 2026-09-08
# =============================================================================
sr_print_review_yaml() {
    : "${SR_D_VER:=}"
    : "${SR_D_KIND:=}"
    : "${SR_D_PURPOSE:=}"
    : "${SR_D_USER:=}"
    : "${SR_D_SVC:=}"
    : "${SR_D_ACT:=}"
    : "${SR_D_SUBMIT_APP:=}"
    : "${SR_D_SUBMIT_VERSION:=}"
    : "${SR_D_SUBMIT_BY:=}"
    : "${SR_D_HAS_CMDS:=0}"
    : "${SR_D_CMDS:=}"
    if [ -n "${SR_D_VER}" ]; then
        sr_yaml_line "schema_version: ${SR_D_VER}"
    fi
    if [ -n "${SR_D_KIND}" ]; then
        sr_yaml_kv "kind" "${SR_D_KIND}"
    fi
    sr_yaml_kv "purpose" "${SR_D_PURPOSE}"
    sr_yaml_kv "username" "${SR_D_USER}"
    sr_yaml_kv "service" "${SR_D_SVC}"
    if [ -n "${SR_D_ACT}" ]; then
        sr_yaml_kv "action" "${SR_D_ACT}"
    fi
    if [ -n "${SR_D_SUBMIT_APP}" ]; then
        sr_yaml_kv "submit_app" "${SR_D_SUBMIT_APP}"
    fi
    if [ -n "${SR_D_SUBMIT_VERSION}" ]; then
        sr_yaml_kv "submit_version" "${SR_D_SUBMIT_VERSION}"
    fi
    if [ -n "${SR_D_SUBMIT_BY}" ]; then
        sr_yaml_kv "submit_by" "${SR_D_SUBMIT_BY}"
    fi
    if [ "${SR_D_HAS_CMDS}" -ne 1 ]; then
        return 0
    fi
    sr_yaml_line "commands:"
    if [ -z "${SR_D_CMDS}" ]; then
        sr_yaml_line "  []"
        return 0
    fi
    _ytf=$(util_mktemp)
    printf '%s' "${SR_D_CMDS}" >"${_ytf}"
    while IFS='|' read -r _yr _ytg _yp _ya || [ -n "${_yp-}" ]; do
        [ -n "${_yp}" ] || continue
        sr_yaml_line "  - runas: $(sr_yaml_scalar "${_yr:-root}")"
        if [ -n "${_ytg}" ]; then
            sr_yaml_line "    tags:"
            sr_yaml_line "      - $(sr_yaml_scalar "${_ytg}")"
        else
            sr_yaml_line "    tags: []"
        fi
        sr_yaml_line "    path: $(sr_yaml_scalar "${_yp}")"
        if [ -n "${_ya}" ]; then
            sr_yaml_line "    args:"
            set -f
            for _yarg in ${_ya}; do
                sr_yaml_line "      - $(sr_yaml_scalar "${_yarg}")"
            done
            set +f
        else
            sr_yaml_line "    args: []"
        fi
    done <"${_ytf}"
    rm -f "${_ytf}"
}

sr_interactive() {
    : "${TTY:=0}"
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${FORCE:=0}"
    if [ "${JSON}" -eq 1 ] || [ "${TTY}" -ne 1 ]; then
        sr_die "interactive needs a TTY (not --json)." "confirm_required"
    fi
    if [ "${QUIET}" -eq 1 ]; then
        sr_die "interactive needs a TTY without --quiet." "confirm_required"
    fi
    sr_require_type1
    # Review {{APP_NAME}}-adm rc: old product-binary hook → {{APP_NAME}}-hook.
    lpu_review_old_login_hook
    sr_require_queues
    sr_require_approver_views
    _in=$(sr_approver_dir request)
    sr_collapse_duplicate_inbound "${_in}"
    _ids=$(mktemp "${TMPDIR:-/tmp}/sr-int.XXXXXX")
    for _f in "${_in}"/sudoer-*.json; do
        [ -f "${_f}" ] || continue
        if [ -L "${_f}" ]; then
            continue
        fi
        _bn=$(basename "${_f}")
        case "${_bn}" in
            sudoer-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-*.json)
                printf '%s\n' "${_bn}" >>"${_ids}"
                ;;
        esac
    done
    if [ ! -s "${_ids}" ]; then
        rm -f "${_ids}"
        out_info "no pending requests"
        return 0
    fi
    _sorted=$(mktemp "${TMPDIR:-/tmp}/sr-int.XXXXXX")
    sort "${_ids}" >"${_sorted}"
    rm -f "${_ids}"
    # prompt_yes_no reads fd 0. Do not redirect the loop over stdin.
    while IFS= read -r _bn <&3; do
        [ -n "${_bn}" ] || continue
        out_info "Request ${_bn}"
        _orig_owner=$(sr_request_owner "${_in}/${_bn}")
        if [ "$(id -u)" -eq 0 ]; then
            sr_chown_request_to_lpu "${_in}/${_bn}"
        fi
        if ! ( sr_dest_fence_or_die "${_in}/${_bn}" "${_bn}" ); then
            if ! ( sr_archive_fenced_rejected "${_in}/${_bn}" "${_bn}" ); then
                out_error "could not move fenced ${_bn} to rejected; continuing"
            fi
            continue
        fi
        # Fence decode ran in a subshell. Parent must decode again (INC-20260821-002).
        _ibody=$(cat "${_in}/${_bn}")
        sr_json_decode_to_fields "${_ibody}"
        sr_dest_review_warn
        if [ -n "${_orig_owner}" ]; then
            sr_stamp_submit_by "${_in}/${_bn}" "${_orig_owner}"
            SR_D_SUBMIT_BY="${_orig_owner}"
        fi
        if [ -n "${SR_D_SUBMIT_APP-}" ] || [ -n "${SR_D_SUBMIT_VERSION-}" ]; then
            sr_yaml_line "queued by ${SR_D_SUBMIT_APP-} ${SR_D_SUBMIT_VERSION-}"
        fi
        # Waiting file stays JSON. Login-hook review body is YAML, indented
        # two spaces so each request groups under [INFO] Request {id}.
        sr_print_review_yaml
        # One-off approval question (requirement-domain-sudoer-approval): yes=approve, no/Enter=reject.
        if prompt_yes_no "Approve this request"; then
            if ! ( SR_OPERAND="${_bn}"; sr_approve ); then
                out_error "approve failed for ${_bn}; continuing"
            fi
        else
            if ! ( SR_OPERAND="${_bn}"; sr_reject ); then
                out_error "reject failed for ${_bn}; continuing"
            fi
        fi
    done 3<"${_sorted}"
    rm -f "${_sorted}"
}

# LPU identity SSOT (requirement-least-privilege-user.md F1–F7).
lpu_defaults() {
    : "${LPU_USER:=sudoer-adm}"
    : "${LPU_UID:=1776}"
    : "${LPU_GID:=1776}"
    : "${LPU_SHELL:=/bin/bash}"
    : "${LPU_HOME:=/etc/sudoer-adm}"
    : "${LPU_HOOK_BEGIN:=# BEGIN sudoer-cli login hook}"
    : "${LPU_HOOK_END:=# END sudoer-cli login hook}"
    : "${COMMON_LOGIN_HOOK_NAME:=sudoer-review-hook}"
    : "${OLD_COMMON_LOGIN_HOOK_NAME:=login-review-hook}"
}

lpu_find_bin() {
    if command -v "$1" >/dev/null 2>&1; then
        command -v "$1"
        return 0
    fi
    if [ -x "/usr/sbin/$1" ]; then
        printf '%s' "/usr/sbin/$1"
        return 0
    fi
    return 1
}

# Mix model: account tools run as `sudo <tool>` (password OK). Never `sudo -n`.
# After `sudo {{APP}} setup` we are already euid 0 — util_sudo skips nested sudo.
# useradd/userdel MUST NOT appear in F6 / print-sudoers (FORB-07).
lpu_sudo() {
    if [ "$(id -u)" -ne 0 ] && ! command -v sudo >/dev/null 2>&1; then
        _cmd=$(sr_operator_cmd)
        sr_die "need root to run: $*" "authz" "sudo ${_cmd} setup"
    fi
    util_sudo "$@"
}

lpu_collision_check() {
    lpu_defaults
    _pw=$(getent passwd "${LPU_UID}" 2>/dev/null || true)
    if [ -n "${_pw}" ]; then
        _n=$(printf '%s' "${_pw}" | cut -d: -f1)
        _h=$(printf '%s' "${_pw}" | cut -d: -f6)
        if [ "${_n}" != "${LPU_USER}" ]; then
            sr_die "cannot create ${LPU_USER}: UID ${LPU_UID} is already account ${_n}." "authz" \
                "getent passwd ${LPU_UID}    (will not steal that UID)"
        fi
        if [ "${_h}" != "${LPU_HOME}" ]; then
            sr_die "cannot create ${LPU_USER}: UID ${LPU_UID} home is ${_h}, expected ${LPU_HOME}." "authz" \
                "getent passwd ${LPU_UID}"
        fi
    fi
    _pw=$(getent passwd "${LPU_USER}" 2>/dev/null || true)
    if [ -n "${_pw}" ]; then
        _u=$(printf '%s' "${_pw}" | cut -d: -f3)
        _g=$(printf '%s' "${_pw}" | cut -d: -f4)
        _h=$(printf '%s' "${_pw}" | cut -d: -f6)
        if [ "${_u}" != "${LPU_UID}" ] || [ "${_g}" != "${LPU_GID}" ]; then
            sr_die "${LPU_USER} already exists as ${_u}:${_g}, expected ${LPU_UID}:${LPU_GID}. Refusing to rewrite a live identity." "authz" \
                "id ${LPU_USER}"
        fi
        if [ "${_h}" != "${LPU_HOME}" ]; then
            sr_die "${LPU_USER} home is ${_h}, expected ${LPU_HOME}. Refusing to move a live home." "authz" \
                "getent passwd ${LPU_USER}"
        fi
    fi
    _gr=$(getent group "${LPU_GID}" 2>/dev/null || true)
    if [ -n "${_gr}" ]; then
        _n=$(printf '%s' "${_gr}" | cut -d: -f1)
        if [ "${_n}" != "${LPU_USER}" ]; then
            sr_die "cannot create group ${LPU_USER}: GID ${LPU_GID} is already ${_n}." "authz" \
                "getent group ${LPU_GID}"
        fi
    fi
    _gr=$(getent group "${LPU_USER}" 2>/dev/null || true)
    if [ -n "${_gr}" ]; then
        _g=$(printf '%s' "${_gr}" | cut -d: -f3)
        if [ "${_g}" != "${LPU_GID}" ]; then
            sr_die "group ${LPU_USER} exists as gid ${_g}, expected ${LPU_GID}. Refusing to rewrite it." "authz" \
                "getent group ${LPU_USER}"
        fi
    fi
}

# Login-hook-symlink: stable ${GLOBAL_BIN}/${COMMON_LOGIN_HOOK_NAME} → product binary.
# Create only when the name is absent. Do not overwrite a retargeted name.
# Test-mode MUST NOT write live /usr/local/bin.
# ALIGNMENT: requirement-login-interactive-review-hook.md · requirement-least-privilege-user.md
lpu_ensure_login_hook_symlink() {
    : "${APP_NAME:=sudoer-cli}"
    : "${COMMON_LOGIN_HOOK_NAME:=sudoer-review-hook}"
    _gb="${GLOBAL_BIN:-/usr/local/bin}"
    _bin="${_gb}/${APP_NAME}"
    _hook="${_gb}/${COMMON_LOGIN_HOOK_NAME}"
    if [ "${SUDOER_CLI_ALLOW_TEST_ROOTS:-0}" = "1" ]; then
        case "${_gb}" in
            /usr/local/bin|/usr/local/bin/)
                return 0
                ;;
        esac
    fi
    if [ ! -e "${_bin}" ] && [ ! -L "${_bin}" ]; then
        return 0
    fi
    if [ -e "${_hook}" ] || [ -L "${_hook}" ]; then
        return 0
    fi
    if ! ln -s "${_bin}" "${_hook}"; then
        sr_die "cannot create ${_hook} as a symlink to ${_bin}" "authz" \
            "sudo ln -s ${_bin} ${_hook}"
    fi
    out_info "Login-hook symlink ${_hook} -> ${_bin}"
}

lpu_ensure_global_bin() {
    _gb="${GLOBAL_BIN:-/usr/local/bin}"
    LPU_GLOBAL_BIN="${_gb}/${APP_NAME}"
    _src=$(util_resolve_running_path)
    if [ -x "${LPU_GLOBAL_BIN}" ]; then
        _have=$(grep '^VERSION="' "${LPU_GLOBAL_BIN}" 2>/dev/null | head -n1 | cut -d'"' -f2)
        _want=""
        if [ -n "${_src}" ] && [ -f "${_src}" ]; then
            _want=$(grep '^VERSION="' "${_src}" 2>/dev/null | head -n1 | cut -d'"' -f2)
        fi
        if [ -n "${_have}" ] && [ -n "${_want}" ] && [ "${_have}" = "${_want}" ]; then
            lpu_ensure_login_hook_symlink
            return 0
        fi
        # Stale global binary. Replace from this ship unit so the login hook matches this VERSION.
    fi
    if [ -z "${_src}" ] || [ ! -f "${_src}" ]; then
        _run=$(util_resolve_running_path)
        _hint="sudo sh ${_run:-<path-to-src/${APP_NAME}>} install"
        sr_die "production F6 needs ${LPU_GLOBAL_BIN}, and it is missing. Cannot resolve this ship unit to copy there." "authz" \
            "${_hint}"
    fi
    mkdir -p "${_gb}" || sr_die "cannot create ${_gb}" "authz"
    _stage=$(mktemp "${TMPDIR:-/tmp}/${APP_NAME}.lpu.XXXXXX") || sr_die "mktemp failed" "authz"
    if ! cp "${_src}" "${_stage}"; then
        rm -f "${_stage}"
        sr_die "cannot stage global binary" "authz"
    fi
    util_chmod 0755 "${_stage}" || true
    if ! mv -f "${_stage}" "${LPU_GLOBAL_BIN}"; then
        rm -f "${_stage}"
        sr_die "cannot install ${LPU_GLOBAL_BIN}" "authz"
    fi
    util_chmod 0755 "${LPU_GLOBAL_BIN}" || true
    if [ ! -x "${LPU_GLOBAL_BIN}" ]; then
        sr_die "installed ${LPU_GLOBAL_BIN} is not executable" "authz"
    fi
    out_info "Installed global binary ${LPU_GLOBAL_BIN} (required for F6)"
    lpu_ensure_login_hook_symlink
}

lpu_f6_text() {
    lpu_defaults
    _gb="${GLOBAL_BIN:-/usr/local/bin}"
    : "${COMMON_LOGIN_HOOK_NAME:=sudoer-review-hook}"
    printf '# %s F6 Table A — production global binary + login-hook-symlink\n' "${APP_NAME}"
    printf '%s ALL=(root) NOPASSWD: %s/%s\n' "${LPU_USER}" "${_gb}" "${APP_NAME}"
    printf '%s ALL=(root) NOPASSWD: %s/%s\n' "${LPU_USER}" "${_gb}" "${COMMON_LOGIN_HOOK_NAME}"
}

lpu_f6_path() {
    lpu_defaults
    printf '%s/%s' "$(sr_sudoers_d_dir)" "${LPU_USER}"
}

lpu_install_f6() {
    lpu_defaults
    _txt=$(lpu_f6_text)
    sr_visudo_text "${_txt}"
    _dest=$(lpu_f6_path)
    sr_forbid_passwd_or_main_sudoers "${_dest}"
    sr_require_product_sudoers_d "${_dest}"
    _dir=$(sr_sudoers_d_dir)
    mkdir -p "${_dir}" || sr_die "cannot create ${_dir}" "authz"
    if [ -f "${_dest}" ]; then
        if [ "${SUDOER_CLI_ALLOW_TEST_ROOTS:-0}" = "1" ]; then
            _bak="${_dir}/.bak"
        else
            _bak="/etc/sudoers.bak"
        fi
        mkdir -p "${_bak}" 2>/dev/null || true
        cp "${_dest}" "${_bak}/${LPU_USER}.bak" 2>/dev/null || true
    fi
    _tmp=$(mktemp "${TMPDIR:-/tmp}/${APP_NAME}.f6.XXXXXX") || sr_die "mktemp failed" "visudo_fail"
    printf '%s\n' "${_txt}" >"${_tmp}"
    if [ "${SUDOER_CLI_ALLOW_TEST_ROOTS:-0}" = "1" ]; then
        install -m 0440 "${_tmp}" "${_dest}" || { rm -f "${_tmp}"; sr_die "cannot install F6 ${_dest}" "authz"; }
    else
        install -m 0440 -o root -g root "${_tmp}" "${_dest}" || { rm -f "${_tmp}"; sr_die "cannot install F6 ${_dest}" "authz"; }
    fi
    rm -f "${_tmp}"
}

lpu_link_home_queue() {
    _link="$1"
    _target="$2"
    if [ -L "${_link}" ]; then
        if ! ln -sfn "${_target}" "${_link}"; then
            sr_die "cannot refresh queue symlink ${_link}" "authz"
        fi
        return 0
    fi
    if [ -d "${_link}" ]; then
        if ! cp -a "${_link}/." "${_target}/"; then
            sr_die "cannot migrate ${_link} to ${_target}" "authz"
        fi
        rm -rf "${_link}"
    fi
    if [ -e "${_link}" ]; then
        sr_die "cannot place queue symlink ${_link}" "authz"
    fi
    if ! ln -sfn "${_target}" "${_link}"; then
        sr_die "cannot create queue symlink ${_link}" "authz"
    fi
}

lpu_mkdir_f5() {
    lpu_defaults
    lpu_resolve_home
    sr_resolve_queues
    _pub="${SUDOER_PUBLIC_QUEUE_ROOT}"
    mkdir -p "${_pub}/sudoer-request" "${_pub}/sudoer-approved" "${_pub}/sudoer-rejected" \
        || sr_die "cannot create public queues under ${_pub}" "authz"
    util_chmod 0755 "${_pub}" || sr_die "cannot chmod public queue root" "authz"
    util_chmod 3773 "${_pub}/sudoer-request" || sr_die "cannot chmod request queue" "authz"
    util_chmod 0700 "${_pub}/sudoer-approved" || sr_die "cannot chmod approved queue" "authz"
    util_chmod 0700 "${_pub}/sudoer-rejected" || sr_die "cannot chmod rejected queue" "authz"
    if [ -d "${LPU_HOME}/sudoer-approving" ] && [ ! -L "${LPU_HOME}/sudoer-approving" ]; then
        if ! cp -a "${LPU_HOME}/sudoer-approving/." "${_pub}/sudoer-request/"; then
            sr_die "cannot migrate old inbound queue" "authz"
        fi
        rm -rf "${LPU_HOME}/sudoer-approving"
    fi
    lpu_link_home_queue "${LPU_HOME}/sudoer-request" "${_pub}/sudoer-request"
    lpu_link_home_queue "${LPU_HOME}/sudoer-approved" "${_pub}/sudoer-approved"
    lpu_link_home_queue "${LPU_HOME}/sudoer-rejected" "${_pub}/sudoer-rejected"
    if getent passwd "${LPU_USER}" >/dev/null 2>&1; then
        if ! chown "${LPU_USER}:${LPU_USER}" "${LPU_HOME}" \
            "${_pub}" "${_pub}/sudoer-request" "${_pub}/sudoer-approved" "${_pub}/sudoer-rejected"; then
            sr_die "cannot chown LPU home/queues" "authz"
        fi
        util_chmod 0751 "${LPU_HOME}" || true
    fi
}

# After create or mktemp+mv, the dest must belong to the LPU (not the elevated invoker).
lpu_own_user_rc() {
    lpu_defaults
    _of="${1:-}"
    [ -n "${_of}" ] && [ -f "${_of}" ] || return 0
    util_chmod 0644 "${_of}" || sr_die "cannot chmod ${_of} for ${LPU_USER}" "authz"
    if getent passwd "${LPU_USER}" >/dev/null 2>&1; then
        chown "${LPU_USER}:${LPU_USER}" "${_of}" || sr_die "cannot chown ${_of} to ${LPU_USER}:${LPU_USER}" "authz"
    fi
}

lpu_hook_text() {
    lpu_defaults
    : "${COMMON_LOGIN_HOOK_NAME:=sudoer-review-hook}"
    _bin="${GLOBAL_BIN:-/usr/local/bin}/${COMMON_LOGIN_HOOK_NAME}"
    printf '%s\n' "${LPU_HOOK_BEGIN}"
    printf '%s\n' "if [ -z \"\${SUDOER_CLI_HOOK_RAN-}\" ] \\"
    printf '%s\n' "  && [ -n \"\${PS1-}\" ] \\"
    printf '%s\n' "  && [ -t 0 ] && [ -t 1 ] \\"   # lpu-hook-rc (not CLI TTY SSOT)
    printf '%s\n' "  && case \$- in *i*) true ;; *) false ;; esac \\"
    printf '%s\n' "  && [ \"\$(id -un)\" = \"${LPU_USER}\" ] \\"
    printf '%s\n' "  && [ -z \"\${SSH_ORIGINAL_COMMAND-}\" ]; then"
    printf '%s\n' "  SUDOER_CLI_HOOK_RAN=1"
    printf '%s\n' "  export SUDOER_CLI_HOOK_RAN"
    printf '%s\n' "  if ! sudo -n ${_bin} interactive; then"   # lpu-hook-rc (login-hook-symlink; specified F6 -n)
    printf '%s\n' "    printf '%s\\n' \"${APP_NAME}: login review did not start. ${LPU_USER} cannot run the review command without a password (the passwordless grant is not installed yet).\" >&2"
    printf '%s\n' "    printf '%s\\n' \"You still have a shell. Next: from a host admin, run: sudo ${APP_NAME} interactive\" >&2"
    printf '%s\n' "  fi"
    printf '%s\n' "fi"
    printf '%s\n' "${LPU_HOOK_END}"
}

lpu_hook_strip() {
    lpu_defaults
    _hf="$1"
    [ -f "${_hf}" ] || return 0
    _ht=$(mktemp "${TMPDIR:-/tmp}/${APP_NAME}.hook.XXXXXX") || sr_die "mktemp failed" "authz"
    awk -v b="${LPU_HOOK_BEGIN}" -v e="${LPU_HOOK_END}" '
        $0 == b { skip=1; next }
        $0 == e { skip=0; next }
        skip { next }
        { print }
    ' "${_hf}" >"${_ht}" || { rm -f "${_ht}"; sr_die "cannot rewrite ${_hf}" "authz"; }
    mv -f "${_ht}" "${_hf}"
    lpu_own_user_rc "${_hf}"
}

lpu_hook_apply() {
    lpu_defaults
    _hf="$1"
    if [ ! -f "${_hf}" ]; then
        : >"${_hf}" || sr_die "cannot create ${_hf}" "authz"
    fi
    lpu_hook_strip "${_hf}"
    printf '\n%s\n' "$(lpu_hook_text)" >>"${_hf}" || sr_die "cannot write hook ${_hf}" "authz"
    lpu_own_user_rc "${_hf}"
}

# =============================================================================
# lpu_rc_has_old_product_hook() - Detect old product-binary login hook
# =============================================================================
#
# GENERAL PURPOSE:
# Return 0 when an rc file still sudo -n's {{GLOBAL_BIN}}/{{APP_NAME}}
# interactive, an old {{APP_NAME}}-hook, or the previous doorbell
# login-review-hook (not sudoer-review-hook).
# Class B: exit status only.
#
# ALIGNMENT:
# - requirement-login-interactive-review-hook.md
#
# Last updated: 2026-09-13
# =============================================================================
lpu_rc_has_old_product_hook() {
    _rf="${1-}"
    : "${APP_NAME:=sudoer-cli}"
    : "${COMMON_LOGIN_HOOK_NAME:=sudoer-review-hook}"
    : "${OLD_COMMON_LOGIN_HOOK_NAME:=login-review-hook}"
    [ -f "${_rf}" ] || return 1
    if grep -q "/${APP_NAME}-hook" "${_rf}" 2>/dev/null; then
        return 0
    fi
    if grep -q "/${APP_NAME} interactive" "${_rf}" 2>/dev/null; then
        return 0
    fi
    if grep -q "/${OLD_COMMON_LOGIN_HOOK_NAME}" "${_rf}" 2>/dev/null; then
        return 0
    fi
    if grep -q "BEGIN sudoer-cli login hook" "${_rf}" 2>/dev/null \
        && ! grep -q "/${COMMON_LOGIN_HOOK_NAME} interactive" "${_rf}" 2>/dev/null; then
        return 0
    fi
    return 1
}

# =============================================================================
# lpu_drop_old_product_hook_lines() - Remove leftover old sudo -n lines
# =============================================================================
#
# GENERAL PURPOSE:
# After marker rewrite, drop leftover product-binary
# "/{{APP_NAME}} interactive", old "/{{APP_NAME}}-hook", and old
# "/login-review-hook" lines. Does not match sudoer-review-hook.
#
# ALIGNMENT:
# - requirement-login-interactive-review-hook.md
#
# Last updated: 2026-09-13
# =============================================================================
lpu_drop_old_product_hook_lines() {
    _df="${1-}"
    : "${APP_NAME:=sudoer-cli}"
    : "${OLD_COMMON_LOGIN_HOOK_NAME:=login-review-hook}"
    [ -f "${_df}" ] || return 0
    if ! grep -qE "/${APP_NAME}(-hook)?( |$)|/${OLD_COMMON_LOGIN_HOOK_NAME}( |$)" "${_df}" 2>/dev/null; then
        return 0
    fi
    _dt=$(mktemp "${TMPDIR:-/tmp}/${APP_NAME}.oldhook.XXXXXX") || sr_die "mktemp failed" "authz"
    if grep -v "/${APP_NAME}-hook" "${_df}" | grep -v "/${APP_NAME} interactive" | grep -v "/${OLD_COMMON_LOGIN_HOOK_NAME}" >"${_dt}"; then
        :
    else
        _dgrc=$?
        if [ "${_dgrc}" -ne 1 ]; then
            rm -f "${_dt}"
            sr_die "cannot drop old login hook lines in ${_df}" "authz"
        fi
    fi
    mv -f "${_dt}" "${_df}"
    lpu_own_user_rc "${_df}"
}

# =============================================================================
# lpu_review_old_login_hook() - Replace old product-binary / *-hook / login-review-hook
# =============================================================================
#
# GENERAL PURPOSE:
# Type 1 interactive (and setup) reviews the dedicated approver rc. If it
# still calls the product binary, an old {{APP_NAME}}-hook, or login-review-hook,
# rewrite to sudoer-review-hook. Already-common rc is left alone. Missing LPU
# home is a no-op.
#
# ALIGNMENT:
# - requirement-login-interactive-review-hook.md
#
# Last updated: 2026-09-13
# =============================================================================
lpu_review_old_login_hook() {
    lpu_defaults
    : "${APP_NAME:=sudoer-cli}"
    : "${COMMON_LOGIN_HOOK_NAME:=sudoer-review-hook}"
    if [ "$(id -u)" -ne 0 ]; then
        return 0
    fi
    if [ ! -d "${LPU_HOME}" ]; then
        return 0
    fi
    lpu_ensure_login_hook_symlink
    _replaced=0
    if lpu_rc_has_old_product_hook "${LPU_HOME}/.bashrc"; then
        lpu_hook_apply "${LPU_HOME}/.bashrc"
        lpu_drop_old_product_hook_lines "${LPU_HOME}/.bashrc"
        _replaced=1
    fi
    if [ -f "${LPU_HOME}/.profile" ]; then
        if lpu_rc_has_old_product_hook "${LPU_HOME}/.profile"; then
            if lpu_profile_sources_bashrc "${LPU_HOME}/.profile"; then
                lpu_hook_strip "${LPU_HOME}/.profile"
                lpu_drop_old_product_hook_lines "${LPU_HOME}/.profile"
            else
                lpu_hook_apply "${LPU_HOME}/.profile"
                lpu_drop_old_product_hook_lines "${LPU_HOME}/.profile"
            fi
            _replaced=1
        fi
    fi
    if [ "${_replaced}" -eq 1 ]; then
        out_info "replaced old ${APP_NAME} login hook with ${COMMON_LOGIN_HOOK_NAME}"
    fi
}

lpu_profile_sources_bashrc() {
    [ -f "$1" ] || return 1
    grep -q '\.bashrc' "$1" 2>/dev/null
}

lpu_profile_text() {
    printf '%s\n' \
        "# BEGIN sudoer-cli profile source-bashrc" \
        "# Created so a bash login shell sources interactive rc (hook lives in .bashrc)." \
        "if [ -n \"\${BASH_VERSION:-}\" ]; then" \
        "    if [ -f \"\${HOME}/.bashrc\" ]; then" \
        "        . \"\${HOME}/.bashrc\"" \
        "    fi" \
        "fi" \
        "# END sudoer-cli profile source-bashrc"
}

# Login shells source .profile, not .bashrc. Missing .profile = hook never fires.
lpu_ensure_profile() {
    lpu_defaults
    _pr="${LPU_HOME}/.profile"
    if [ -f "${_pr}" ]; then
        lpu_own_user_rc "${_pr}"
        return 0
    fi
    mkdir -p "${LPU_HOME}" || sr_die "cannot create ${LPU_HOME}" "authz"
    _ptmp=$(mktemp "${LPU_HOME}/.profile.sudoer-cli.XXXXXX") || sr_die "cannot stage .profile" "authz"
    lpu_profile_text >"${_ptmp}" || { rm -f "${_ptmp}"; sr_die "cannot write .profile" "authz"; }
    util_chmod 0644 "${_ptmp}" || { rm -f "${_ptmp}"; sr_die "cannot chmod staged .profile" "authz"; }
    if [ ! -f "${_pr}" ]; then
        mv -f "${_ptmp}" "${_pr}" || { rm -f "${_ptmp}"; sr_die "cannot create ${_pr}" "authz"; }
    else
        rm -f "${_ptmp}"
    fi
    lpu_own_user_rc "${_pr}"
}

# ALIGNMENT: requirement-login-interactive-review-hook.md
lpu_install_hook() {
    lpu_defaults
    lpu_hook_apply "${LPU_HOME}/.bashrc"
    lpu_ensure_profile
    _pr="${LPU_HOME}/.profile"
    if [ -f "${_pr}" ]; then
        if lpu_profile_sources_bashrc "${_pr}"; then
            lpu_hook_strip "${_pr}"
        else
            lpu_hook_apply "${_pr}"
        fi
    fi
}

lpu_create_account() {
    lpu_defaults
    _groupadd=$(lpu_find_bin groupadd) || sr_die "groupadd is not installed (need /usr/sbin/groupadd)." "authz" \
        "which groupadd || ls /usr/sbin/groupadd"
    _useradd=$(lpu_find_bin useradd) || sr_die "useradd is not installed (need /usr/sbin/useradd)." "authz" \
        "which useradd || ls /usr/sbin/useradd"
    mkdir -p "${LPU_HOME}" || sr_die "cannot create home ${LPU_HOME}." "authz" \
        "ls -ld $(dirname "${LPU_HOME}")"
    if ! getent group "${LPU_USER}" >/dev/null 2>&1; then
        lpu_sudo "${_groupadd}" -g "${LPU_GID}" "${LPU_USER}" || sr_die "groupadd ${LPU_USER} (gid ${LPU_GID}) failed." "authz" \
            "getent group ${LPU_GID}; getent group ${LPU_USER}"
    fi
    if ! getent passwd "${LPU_USER}" >/dev/null 2>&1; then
        # -M: we already created ${LPU_HOME} (under /etc). -m + HOME=/home can refuse that path.
        lpu_sudo "${_useradd}" -u "${LPU_UID}" -g "${LPU_GID}" -d "${LPU_HOME}" -s "${LPU_SHELL}" -M "${LPU_USER}" \
            || sr_die "useradd ${LPU_USER} (uid ${LPU_UID}) failed." "authz" \
            "getent passwd ${LPU_UID}; getent passwd ${LPU_USER}"
    fi
    util_chmod 0751 "${LPU_HOME}" || true
    chown "${LPU_USER}:${LPU_USER}" "${LPU_HOME}" || sr_die "cannot chown ${LPU_HOME} to ${LPU_USER}." "authz" \
        "ls -ld ${LPU_HOME}; id ${LPU_USER}"
}

lpu_archive_queues() {
    lpu_defaults
    sr_resolve_queues
    _day=$(date +%Y%m%d)
    _base="/var/backups/${APP_NAME}"
    if [ "${SUDOER_CLI_ALLOW_TEST_ROOTS:-0}" = "1" ]; then
        _base="${LPU_HOME}/.lpu-archive"
    fi
    _n=1
    while [ -e "${_base}/${_day}-${_n}" ]; do
        _n=$((_n + 1))
    done
    _arch="${_base}/${_day}-${_n}"
    mkdir -p "${_arch}" || sr_die "cannot create archive ${_arch}" "authz"
    for _q in "${SUDOER_QUEUE_REQUEST}" "${SUDOER_QUEUE_APPROVED}" "${SUDOER_QUEUE_REJECTED}"; do
        if [ -d "${_q}" ]; then
            cp -a "${_q}" "${_arch}/" || sr_die "cannot archive ${_q}" "authz"
        fi
    done
    printf '%s' "${_arch}"
}

# Remove only the three known public queue children, then rmdir the root if empty.
lpu_remove_public_queues() {
    lpu_defaults
    lpu_resolve_home
    sr_resolve_queues
    _pub="${SUDOER_PUBLIC_QUEUE_ROOT}"
    [ -n "${_pub}" ] || return 0
    for _n in sudoer-request sudoer-approved sudoer-rejected; do
        _p="${_pub}/${_n}"
        if [ -e "${_p}" ] || [ -L "${_p}" ]; then
            rm -rf "${_p}"
        fi
    done
    if [ -d "${_pub}" ]; then
        rmdir "${_pub}" 2>/dev/null || true
    fi
}

lpu_setup() {
    sr_require_type1_bootstrap
    if [ "${SR_UNINSTALL:-0}" -eq 1 ]; then
        lpu_remove
        return 0
    fi
    lpu_defaults
    lpu_collision_check
    LPU_GLOBAL_BIN="${GLOBAL_BIN:-/usr/local/bin}/${APP_NAME}"
    lpu_ensure_global_bin
    lpu_create_account
    lpu_mkdir_f5
    lpu_install_f6
    lpu_install_hook
    lpu_review_old_login_hook
    if [ "${JSON}" -eq 1 ]; then
        out_json "success" "lpu ready" \
            "user" "${LPU_USER}" \
            "uid" "${LPU_UID}" \
            "home" "${LPU_HOME}" \
            "f6" "$(lpu_f6_path)" \
            "binary" "${LPU_GLOBAL_BIN}"
    else
        out_success "LPU ${LPU_USER} ready (uid ${LPU_UID}, home ${LPU_HOME})"
        out_info "F6 $(lpu_f6_path)"
        out_info "Global binary ${LPU_GLOBAL_BIN}"
        out_info "Login-hook symlink ${GLOBAL_BIN:-/usr/local/bin}/${COMMON_LOGIN_HOOK_NAME:-sudoer-review-hook}"
        _cmd=$(sr_operator_cmd)
        out_info "Next: as yourself (not ${LPU_USER}), ${_cmd} add-sudoer-request --file request.json"
        out_info "Then this sudo is the approval: sudo ${_cmd} interactive"
    fi
}

lpu_remove() {
    sr_require_type1_bootstrap
    lpu_defaults
    lpu_resolve_home
    if [ "${FORCE:-0}" -eq 0 ]; then
        if [ "${JSON}" -eq 1 ] || [ "${QUIET}" -eq 1 ] || [ "${TTY}" -eq 0 ]; then
            _cmd=$(sr_operator_cmd)
            sr_die "remove-lpu needs a yes/no on a TTY (this run is non-interactive)." "confirm_required" \
                "sudo ${_cmd} remove-lpu --force"
        fi
        if ! prompt_yes_no "Remove LPU ${LPU_USER}? Live grants stay."; then
            out_info "remove-lpu cancelled"
            return 0
        fi
    fi
    out_warn "Live service-user grants stay (no --purge-grants in v1)"
    if [ -f "${LPU_HOME}/.bashrc" ]; then
        lpu_hook_strip "${LPU_HOME}/.bashrc"
    fi
    if [ -f "${LPU_HOME}/.profile" ]; then
        lpu_hook_strip "${LPU_HOME}/.profile"
    fi
    _arch=""
    if [ "${SR_PURGE_QUEUES:-0}" -ne 1 ]; then
        _arch=$(lpu_archive_queues)
    fi
    lpu_remove_public_queues
    _dest=$(lpu_f6_path)
    sr_forbid_passwd_or_main_sudoers "${_dest}"
    sr_require_product_sudoers_d "${_dest}"
    if [ -f "${_dest}" ]; then
        if [ "${SUDOER_CLI_ALLOW_TEST_ROOTS:-0}" = "1" ]; then
            _bak="$(dirname "${_dest}")/.bak"
        else
            _bak="/etc/sudoers.bak"
        fi
        mkdir -p "${_bak}" 2>/dev/null || true
        mv "${_dest}" "${_bak}/${LPU_USER}.bak" 2>/dev/null || rm -f "${_dest}"
    fi
    if getent passwd "${LPU_USER}" >/dev/null 2>&1; then
        _userdel=$(lpu_find_bin userdel) || sr_die "userdel is not installed (need /usr/sbin/userdel)." "authz" \
            "which userdel || ls /usr/sbin/userdel"
        lpu_sudo "${_userdel}" -r "${LPU_USER}" || sr_die "sudo userdel -r ${LPU_USER} failed. Account may still exist." "authz" \
            "id ${LPU_USER}; getent passwd ${LPU_USER}"
    fi
    if getent group "${LPU_USER}" >/dev/null 2>&1; then
        _groupdel=$(lpu_find_bin groupdel) || true
        if [ -n "${_groupdel}" ]; then
            lpu_sudo "${_groupdel}" "${LPU_USER}" 2>/dev/null || true
        fi
    fi
    if [ "${JSON}" -eq 1 ]; then
        out_json "success" "lpu removed" "user" "${LPU_USER}" "archive" "${_arch}"
    else
        out_success "Removed LPU ${LPU_USER}"
        if [ -n "${_arch}" ]; then
            out_info "Queued archive: ${_arch}"
        fi
    fi
}


# =============================================================================
# util_persistent_storage_dir() - Durable this-login folder (not the cache)
# =============================================================================
#
# GENERAL PURPOSE:
# The language leaf lives under ${HOME}/.local/${APP_NAME}. This helper only
# prints that directory. It does not create it. Save creates it.
#
# ALIGNMENT:
# - requirement-shell-cli-storage.md
# - requirement-shell-cli-language.md
#
# Last updated: 2026-10-02
# =============================================================================
util_persistent_storage_dir() {
    : "${APP_NAME:=sudoer-cli}"
    : "${HOME:=/tmp}"
    printf '%s' "${HOME}/.local/${APP_NAME}"
}

# =============================================================================
# app_lang_load() - One accepted code for this process
# =============================================================================
#
# GENERAL PURPOSE:
# APP_LANG is one accepted code. A missing file, an empty file, or any other
# first line stays en and is not rewritten. SUDOER_CLI_LANG wins over the
# file when it is one of those codes and does not write the file.
# One call at the start of dispatch inside app_main. A later pick updates
# APP_LANG in this process; do not call this again in that process or the
# env value would cover the pick.
#
# ALIGNMENT:
# - requirement-shell-cli-language.md
# - requirement-shell-cli-storage.md
#
# Last updated: 2026-10-02
# =============================================================================
app_lang_load() {
    APP_LANG=en
    _ll_path="$(util_persistent_storage_dir)/language"
    if [ -f "${_ll_path}" ]; then
        _ll_line=$(head -n 1 "${_ll_path}" 2>/dev/null || true)
        _ll_line=$(printf '%s' "${_ll_line}" | tr -d '\r')
        case "${_ll_line}" in
            en|zh-Hans|zh-Hant|es|ar|fr|pt|ru|de|ja|ko|nl|el) APP_LANG="${_ll_line}" ;;
        esac
    fi
    case "${SUDOER_CLI_LANG-}" in
        en|zh-Hans|zh-Hant|es|ar|fr|pt|ru|de|ja|ko|nl|el) APP_LANG="${SUDOER_CLI_LANG}" ;;
    esac
    export APP_LANG
    unset _ll_path _ll_line
}

# =============================================================================
# app_lang_save() - Write one language code, mode 0600
# =============================================================================
#
# GENERAL PURPOSE:
# Write one line under persistence and set APP_LANG only after the write
# succeeds. A code outside the thirteen returns failure and leaves APP_LANG
# unchanged. A failed directory create returns failure and does not die.
#
# ALIGNMENT:
# - requirement-shell-cli-language.md
# - requirement-shell-cli-storage.md
#
# Last updated: 2026-10-02
# =============================================================================
app_lang_save() {
    _ls_code=${1-}
    case "${_ls_code}" in
        en|zh-Hans|zh-Hant|es|ar|fr|pt|ru|de|ja|ko|nl|el) ;;
        *)
            unset _ls_code
            return 1
            ;;
    esac
    _ls_dir=$(util_persistent_storage_dir)
    if ! mkdir -p "${_ls_dir}" 2>/dev/null; then
        unset _ls_code _ls_dir
        return 1
    fi
    _ls_path="${_ls_dir}/language"
    if ! printf '%s\n' "${_ls_code}" > "${_ls_path}"; then
        unset _ls_code _ls_dir _ls_path
        return 1
    fi
    chmod 0600 "${_ls_path}" 2>/dev/null || true
    APP_LANG="${_ls_code}"
    export APP_LANG
    unset _ls_code _ls_dir _ls_path
    return 0
}

