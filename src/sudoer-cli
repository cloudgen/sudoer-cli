# Domain fatal with machine error code (requirement-domain-sudoer-approval).
# $1 human what-failed  $2 code  $3 optional pasteable next command (no "sudo -n")
sr_die() {
    _sr_msg="${1-}"
    _sr_code="${2:-unknown}"
    _sr_next="${3-}"
    _sr_json="${_sr_msg}"
    if [ -n "${_sr_next}" ]; then
        _sr_json="${_sr_msg} Next: ${_sr_next}"
    fi
    util_scratch_cleanup 2>/dev/null || true
    out_json_error "${_sr_json}" "${_sr_code}"
    out_text out_error "${_sr_msg}"
    if [ -n "${_sr_next}" ]; then
        out_text out_error "Next: ${_sr_next}"
    fi
    exit 1
}

