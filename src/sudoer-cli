# =============================================================================
# app_main() - Main entrypoint and command dispatcher
# =============================================================================
#
# GENERAL PURPOSE:
# Single dispatcher: Type 0 lifecycle + routed domain verbs.
# Empty argv = Type N help (not install-ensure; not interactive).
#
# ALIGNMENT:
# - requirement-shell-cli-interface.md
# - requirement-shell-cli-zero-arguments.md
# - requirement-domain-sudoer-approval.md
#
# Last reviewed: 2026-08-14
# =============================================================================
app_main() {
    : "${COMMAND:=help}"
    : "${QUIET:=0}"
    : "${JSON:=0}"
    : "${DEBUG:=0}"
    : "${FORCE:=0}"
    : "${FORCE_REINSTALL:=0}"
    : "${FORCE_GLOBAL:=0}"
    : "${USERNAME:=unknown}"
    : "${HOME:=/tmp}"
    : "${XDG_CACHE_HOME:=${HOME}/.cache}"
    : "${APP_NAME:=cli-template}"
    : "${STORAGE_DIR:=${XDG_CACHE_HOME}/${APP_NAME}-${USERNAME}}"
    : "${SR_FILE:=}"
    : "${SR_DIR:=}"
    : "${SR_EXPECT_MATCH:=0}"
    : "${SR_ACTION:=}"
    : "${SR_PURPOSE:=}"
    : "${SR_SERVICE:=}"
    : "${SR_OUT:=}"
    : "${SR_OPERAND:=}"
    : "${SR_ORPHANS:=0}"
    : "${SR_UNINSTALL:=0}"
    : "${SR_PURGE_QUEUES:=0}"
    : "${COMMAND_SET:=0}"

    USERNAME=$(id -un 2>/dev/null || echo "${USERNAME}")
    EFFECTIVE_STORAGE_DIR=$(util_resolve_storage)
    export EFFECTIVE_STORAGE_DIR STORAGE_DIR
    export TMPDIR="${EFFECTIVE_STORAGE_DIR}"
    trap util_scratch_cleanup EXIT INT TERM

    if [ $# -eq 0 ]; then
        app_help
        return 0
    fi

    while [ $# -gt 0 ]; do
        case "$1" in
            --quiet|-q) QUIET=1 ;;
            --json)     JSON=1; QUIET=1 ;;
            --debug)    DEBUG=1 ;;
            --force)    FORCE=1; FORCE_REINSTALL=1 ;;
            --global)   FORCE_GLOBAL=1; export FORCE_GLOBAL ;;
            --file)
                [ -n "${2-}" ] || out_die "--file requires PATH"
                SR_FILE="$2"; shift
                ;;
            --dir)
                [ -n "${2-}" ] || out_die "--dir requires DIR"
                SR_DIR="$2"; shift
                ;;
            --expect-match) SR_EXPECT_MATCH=1 ;;
            --action)
                [ -n "${2-}" ] || out_die "--action requires add|update"
                SR_ACTION="$2"; shift
                ;;
            --purpose)
                [ -n "${2-}" ] || out_die "--purpose requires TEXT"
                SR_PURPOSE="$2"; shift
                ;;
            --service)
                [ -n "${2-}" ] || out_die "--service requires NAME"
                SR_SERVICE="$2"; shift
                ;;
            --out)
                [ -n "${2-}" ] || out_die "--out requires PATH"
                SR_OUT="$2"; shift
                ;;
            --queue-root)
                [ -n "${2-}" ] || out_die "--queue-root requires DIR"
                SR_QUEUE_ROOT="$2"; shift
                ;;
            --request-dir)
                [ -n "${2-}" ] || out_die "--request-dir requires DIR"
                SR_REQUEST_DIR="$2"; shift
                ;;
            --approved-dir)
                [ -n "${2-}" ] || out_die "--approved-dir requires DIR"
                SR_APPROVED_DIR="$2"; shift
                ;;
            --rejected-dir)
                [ -n "${2-}" ] || out_die "--rejected-dir requires DIR"
                SR_REJECTED_DIR="$2"; shift
                ;;
            --user)
                [ -n "${2-}" ] || out_die "--user requires NAME"
                SR_LIST_USER="$2"; shift
                ;;
            --orphans)    SR_ORPHANS=1 ;;
            --uninstall)  SR_UNINSTALL=1 ;;
            --purge-queues) SR_PURGE_QUEUES=1 ;;
            version|about|help|install|uninstall|where-is-me|\
            sudoers-to-json|json-to-sudoers|test-json-format|test-well-known-binary|fence-test|print-sudoers|print-sudoers-install-script|\
            add-sudoer-request|update-sudoer-request|remove-sudoer-request|\
            list-approving|list-approved|list-rejected|show|approve|reject|\
            interactive|setup|remove-lpu)
                if [ "${COMMAND_SET}" -eq 1 ]; then
                    SR_OPERAND="$1"
                else
                    COMMAND="$1"
                    COMMAND_SET=1
                fi
                ;;
            -*)
                out_die "Unknown command or flag: $1. See '${APP_NAME} help'."
                ;;
            *)
                if [ "${COMMAND_SET}" -eq 1 ]; then
                    SR_OPERAND="$1"
                else
                    out_die "Unknown command or flag: $1. See '${APP_NAME} help'."
                fi
                ;;
        esac
        shift
    done

    out_debug "dispatch command=${COMMAND} quiet=${QUIET} json=${JSON}"

    case "${COMMAND}" in
        version)      app_version ;;
        about)        app_about ;;
        install)      inst_local_install ;;
        uninstall)    inst_local_uninstall ;;
        where-is-me)  app_where_is_me ;;
        sudoers-to-json) sr_sudoers_to_json ;;
        json-to-sudoers) sr_json_to_sudoers ;;
        test-json-format) sr_test_json_format ;;
        test-well-known-binary) sr_test_well_known_binary ;;
        fence-test) sr_fence_test ;;
        print-sudoers) sr_print_sudoers ;;
        print-sudoers-install-script) sr_print_sudoers_install_script ;;
        add-sudoer-request)    sr_submit add ;;
        update-sudoer-request) sr_submit update ;;
        remove-sudoer-request) sr_submit remove ;;
        list-approving)  sr_list approving ;;
        list-approved)   sr_list approved ;;
        list-rejected)   sr_list rejected ;;
        show)            sr_show ;;
        approve)         sr_approve ;;
        reject)          sr_reject ;;
        interactive)     sr_interactive ;;
        setup)           lpu_setup ;;
        remove-lpu)      lpu_remove ;;
        help|*)          app_help ;;
    esac
}

