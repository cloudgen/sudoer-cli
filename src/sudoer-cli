    out_plain "  test-well-known-binary  Test grant command paths against the well-known system-binary fence (does not queue)"
    out_plain "  fence-test            Test dest fence functions against a local JSON file (no sudo; does not queue)"
    out_plain "  rc-test              Prove PATH/profile ensure in --root tmp (--file bashrc|profile --case create|modify|noop). Does not write this login's real ~/.bashrc"
    out_empty_line
    out_info "First-time setup (host admin; password sudo OK):"
    out_plain "  setup / remove-lpu   Create or remove the dedicated approver account (sudoer-adm). Run: sudo ${APP_NAME} setup"
