# =============================================================================
# util_get_current_shell() - Detect current / parent shell name
# =============================================================================
#
# GENERAL PURPOSE:
# Returns a best-effort shell command name for diagnostics (about).
# Prefer parent shell when the current process is sh/dash/ash/the app itself.
#
# PRINTF EXCEPTION (class B – function return-via-stdout):
# Final printf '%s' "$shell" (and echo fallbacks inside $(…)) are data
# returns for capture by app_about — not product messages. Display uses out_*.
# See requirement-shell-output-requirements.md §2.1.1.
#
# !!! DO NOT MODIFY OR SIMPLIFY THIS FUNCTION !!!
# Nested functions are not portable POSIX; this must stay top-level.
#
# Last reviewed: 2026-07-12

util_get_current_shell() {
    local shell="unknown"
    shell=$(ps -p $$ -o comm= 2>/dev/null | tr -d '()' || echo "unknown")

    if [ "$shell" = "${APP_NAME}" ] || [ "$shell" = "sh" ] || \
       [ "$shell" = "dash" ] || [ "$shell" = "ash" ]; then
        local parent_pid
        parent_pid=$(ps -p $$ -o ppid= 2>/dev/null | tr -d ' ')
        if [ -n "$parent_pid" ]; then
            shell=$(ps -p "$parent_pid" -o comm= 2>/dev/null | tr -d '()' || echo "$shell")
        fi
    fi
    printf '%s' "$shell"
}



# =============================================================================
# util_resolve_running_path() - Absolute path of running ship unit (class B)
# =============================================================================
#
# GENERAL PURPOSE:
# Resolve the absolute path of the currently executing ship unit for local
# install source. Returns empty string when $0 is not a resolvable file
# (e.g. stdin pipe degradation).
#
# PRINTF EXCEPTION (class B): path data for $(…) capture only.
#
# ALIGNMENT:
# - requirement-shell-local-self-management.md
#
# Last reviewed: 2026-08-03
# =============================================================================
util_resolve_running_path() {
    : "${0:=}"
    _src="$0"
    _resolved=""

    case "$_src" in
        ""|sh|bash|dash|ash|zsh|ksh|*/sh|*/bash|*/dash|*/ash|*/zsh|*/ksh)
            if [ ! -f "$_src" ]; then
                printf '%s' ""
                return 0
            fi
            ;;
    esac

    if [ ! -f "$_src" ] && [ ! -L "$_src" ]; then
        printf '%s' ""
        return 0
    fi

    if command -v readlink >/dev/null 2>&1; then
        _resolved=$(readlink -f "$_src" 2>/dev/null || true)
        if [ -n "$_resolved" ] && [ -e "$_resolved" ]; then
            printf '%s' "$_resolved"
            return 0
        fi
    fi
    if command -v realpath >/dev/null 2>&1; then
        _resolved=$(realpath "$_src" 2>/dev/null || true)
        if [ -n "$_resolved" ] && [ -e "$_resolved" ]; then
            printf '%s' "$_resolved"
            return 0
        fi
    fi

    # Fallback: dirname/basename join
    _dir=$(CDPATH= cd -- "$(dirname -- "$_src")" 2>/dev/null && pwd)
    _base=$(basename -- "$_src")
    if [ -n "$_dir" ] && [ -f "${_dir}/${_base}" ]; then
        printf '%s' "${_dir}/${_base}"
        return 0
    fi
    printf '%s' ""
}

