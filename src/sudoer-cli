    out_plain "                         Interactive rc write path for PATH ensure (tests may retarget)"
    out_plain "  REPO_USER / REPO_NAME  repository identity (compose SCRIPT_URL)"
    out_plain "  SCRIPT_URL             install channel (override for forks / tests)"
    out_empty_line
    out_info "Examples:"
    out_plain "  curl -fsSL ${SCRIPT_URL} | sh"
    out_plain "  ${APP_NAME} install               # any user → ~/.local/bin"
    out_plain "  sudo ${APP_NAME} install          # any admin → /usr/local/bin (password sudo OK)"
    out_plain "  sudo ${APP_NAME} setup            # any admin bootstrap (password sudo OK; not -n)"
    out_plain "  sudo ${APP_NAME} interactive      # any admin after setup (password sudo is the approval)"
    out_plain "  ${APP_NAME} menu                  # numbered list (real terminal)"
    out_plain "  ${APP_NAME} version"
    out_plain "  ${APP_NAME} about"
    out_plain "  ${APP_NAME} --json about"
    out_plain "  ${APP_NAME} version-check"
    out_plain "  ${APP_NAME} self-update"
    out_plain "  ${APP_NAME} self-uninstall --force"
    out_plain "  ${APP_NAME} sudoers-to-json --file grant.sudoers --action add --purpose '…'"
    out_plain "  ${APP_NAME} test-json-format --file request.json"
    out_plain "  ${APP_NAME} test-well-known-binary --file request.json"
    out_plain "  ${APP_NAME} fence-test --file tests/fixtures/fence-test/pass/login-hook-elev-dns-adm.json"
    out_plain "  ${APP_NAME} fence-test --dir tests/fixtures/fence-test/pass"
    out_plain "  ${APP_NAME} fence-test --dir tests/fixtures/fence-test/match --expect-match"
    out_plain "  ${APP_NAME} rc-test --root /tmp/rc-test --file bashrc --case create"
    out_empty_line
    out_info "Empty argv installs or confirms install (Type O — curl|sh install-ensure). Help is: ${APP_NAME} help"
}

# =============================================================================
# app_main() - Main entrypoint and command dispatcher
# =============================================================================
#
# GENERAL PURPOSE:
# Single dispatcher: Type 0 lifecycle + routed domain verbs.
# Empty argv = Type O install-ensure (not help; not interactive; not the menu).
# Verb menu / main = TTY numbered list (requirement-shell-cli-default-interaction).
#
# ALIGNMENT:
# - requirement-shell-cli-interface.md
# - requirement-shell-cli-zero-arguments.md
# - requirement-shell-cli-default-interaction.md
# - requirement-domain-sudoer-approval.md
#
# Last updated: 2026-09-03
# =============================================================================
app_main() {
    : "${COMMAND:=help}"
    : "${QUIET:=0}"
    : "${JSON:=0}"
    : "${DEBUG:=0}"
    : "${FORCE:=0}"
    : "${FORCE_REINSTALL:=0}"
    : "${FORCE_GLOBAL:=0}"
    : "${USERNAME:=unknown}"
    : "${HOME:=/tmp}"
    : "${XDG_CACHE_HOME:=${HOME}/.cache}"
    : "${APP_NAME:=cli-template}"
    : "${STORAGE_DIR:=${XDG_CACHE_HOME}/${APP_NAME}-${USERNAME}}"
    : "${SR_FILE:=}"
    : "${SR_DIR:=}"
    : "${SR_EXPECT_MATCH:=0}"
    : "${SR_ACTION:=}"
    : "${SR_PURPOSE:=}"
    : "${SR_SERVICE:=}"
    : "${SR_OUT:=}"
    : "${SR_OPERAND:=}"
    : "${SR_ORPHANS:=0}"
    : "${SR_UNINSTALL:=0}"
    : "${SR_PURGE_QUEUES:=0}"
    : "${COMMAND_SET:=0}"
    : "${RC_TEST_OPERANDS:=}"

    USERNAME=$(id -un 2>/dev/null || echo "${USERNAME}")
    EFFECTIVE_STORAGE_DIR=$(util_resolve_storage)
    export EFFECTIVE_STORAGE_DIR STORAGE_DIR
    export TMPDIR="${EFFECTIVE_STORAGE_DIR}"
    trap util_scratch_cleanup EXIT INT TERM

    if [ $# -eq 0 ]; then
        if [ "${JSON}" -eq 1 ] || [ "${QUIET}" -eq 1 ]; then
            inst_perform_install
            return $?
        elif inst_is_installed; then
            inst_perform_install
            return $?
        else
            inst_maybe_install
            return $?
        fi
    fi

    while [ $# -gt 0 ]; do
        case "$1" in
            --quiet|-q) QUIET=1 ;;
            --json)     JSON=1; QUIET=1 ;;
            --debug)    DEBUG=1 ;;
            --force)    FORCE=1; FORCE_REINSTALL=1 ;;
            --global)   FORCE_GLOBAL=1; export FORCE_GLOBAL ;;
            --file)
                [ -n "${2-}" ] || out_die "--file requires PATH"
                if [ "${COMMAND}" = "rc-test" ]; then
                    RC_TEST_OPERANDS="${RC_TEST_OPERANDS:+${RC_TEST_OPERANDS} }--file $2"
                else
                    SR_FILE="$2"
                fi
                shift
                ;;
            --root|--case|--feature)
                if [ "${COMMAND}" = "rc-test" ]; then
                    [ -n "${2-}" ] || out_die "rc-test $1 requires a value"
                    RC_TEST_OPERANDS="${RC_TEST_OPERANDS:+${RC_TEST_OPERANDS} }$1 $2"
                    shift
                else
                    out_die "Unknown command or flag: $1. See '${APP_NAME} help'."
                fi
                ;;
            --dir)
                [ -n "${2-}" ] || out_die "--dir requires DIR"
                SR_DIR="$2"; shift
                ;;
            --expect-match) SR_EXPECT_MATCH=1 ;;
            --action)
                [ -n "${2-}" ] || out_die "--action requires add|update"
                SR_ACTION="$2"; shift
                ;;
            --purpose)
                [ -n "${2-}" ] || out_die "--purpose requires TEXT"
                SR_PURPOSE="$2"; shift
                ;;
            --service)
                [ -n "${2-}" ] || out_die "--service requires NAME"
                SR_SERVICE="$2"; shift
                ;;
            --out)
                [ -n "${2-}" ] || out_die "--out requires PATH"
                SR_OUT="$2"; shift
                ;;
            --queue-root)
                [ -n "${2-}" ] || out_die "--queue-root requires DIR"
                SR_QUEUE_ROOT="$2"; shift
                ;;
            --request-dir)
                [ -n "${2-}" ] || out_die "--request-dir requires DIR"
                SR_REQUEST_DIR="$2"; shift
                ;;
            --approved-dir)
                [ -n "${2-}" ] || out_die "--approved-dir requires DIR"
                SR_APPROVED_DIR="$2"; shift
                ;;
            --rejected-dir)
                [ -n "${2-}" ] || out_die "--rejected-dir requires DIR"
                SR_REJECTED_DIR="$2"; shift
                ;;
            --user)
                [ -n "${2-}" ] || out_die "--user requires NAME"
                SR_LIST_USER="$2"; shift
                ;;
            --orphans)    SR_ORPHANS=1 ;;
            --uninstall)  SR_UNINSTALL=1 ;;
            --purge-queues) SR_PURGE_QUEUES=1 ;;
            version|about|help|install|version-check|self-update|self-uninstall|menu|main|\
            sudoers-to-json|json-to-sudoers|test-json-format|test-well-known-binary|fence-test|rc-test|print-sudoers|print-sudoers-install-script|\
            add-sudoer-request|update-sudoer-request|remove-sudoer-request|\
            list-approving|list-approved|list-rejected|show|approve|reject|\
            interactive|setup|remove-lpu)
                if [ "${COMMAND_SET}" -eq 1 ]; then
                    SR_OPERAND="$1"
                else
                    COMMAND="$1"
                    COMMAND_SET=1
                fi
                ;;
            -*)
                if [ "${COMMAND}" = "rc-test" ]; then
                    RC_TEST_OPERANDS="${RC_TEST_OPERANDS:+${RC_TEST_OPERANDS} }$1"
                else
                    out_die "Unknown command or flag: $1. See '${APP_NAME} help'."
                fi
                ;;
            *)
                if [ "${COMMAND}" = "rc-test" ]; then
                    RC_TEST_OPERANDS="${RC_TEST_OPERANDS:+${RC_TEST_OPERANDS} }$1"
                elif [ "${COMMAND_SET}" -eq 1 ]; then
                    SR_OPERAND="$1"
                else
                    out_die "Unknown command or flag: $1. See '${APP_NAME} help'."
                fi
                ;;
        esac
        shift
    done

    out_debug "dispatch command=${COMMAND} quiet=${QUIET} json=${JSON}"

    app_run_command
}

# =============================================================================
# BOOTSTRAP
# =============================================================================
# Always invoke app_main. No basename gate (pipe-safe entry).
# Product law: requirement-shell-cli-zero-arguments.md (Type O).
# =============================================================================
app_main "$@"
