# =============================================================================
# app_main_menu() - TTY menu (verb menu / main; empty argv is Type O install-ensure)
# =============================================================================
#
# GENERAL PURPOSE:
# Interactive (TTY=1): ignore --json, draw the numbered list, read a choice
# in the current shell (PROMPT_ASK_VALUE; MUST NOT $() prompt_ask), run that
# handler. Non-interactive: help (human or JSON). MUST NOT hang. MUST NOT
# swallow help under --quiet.
#
# ALIGNMENT:
# - requirement-shell-cli-default-interaction.md
# - requirement-shell-cli-zero-arguments.md (empty argv is not this path)
# - requirement-shell-prompt.md (PROMPT_ASK_VALUE)
#
# Last updated: 2026-09-03
# =============================================================================
app_main_menu() {
    : "${TTY:=0}"
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${PROMPT_ASK_VALUE:=}"

    if [ "${TTY}" -ne 1 ]; then
        if [ "${JSON}" -eq 0 ]; then
            QUIET=0
        fi
        app_help
        return 0
    fi

    # Interactive menu ignores --json (case 3). Restore after the choice read.
    local _menu_json="${JSON}"
    local _menu_quiet="${QUIET}"
    local _choice=""
    JSON=0
    QUIET=0
    app_main_menu_print
    # WARNING — do-not-capture-read (PP-A-22)
    # MUST NOT _choice=$(prompt_ask …) / $() / backticks. Body of prompt_ask contains read.
    prompt_ask "Choice" ""
    _choice="${PROMPT_ASK_VALUE}"
    JSON="${_menu_json}"
    QUIET="${_menu_quiet}"

    case "${_choice}" in
        1|sudoers-to-json) COMMAND=sudoers-to-json ;;
        2|json-to-sudoers) COMMAND=json-to-sudoers ;;
        3|print-sudoers) COMMAND=print-sudoers ;;
        4|print-sudoers-install-script) COMMAND=print-sudoers-install-script ;;
        5|add-sudoer-request) COMMAND=add-sudoer-request ;;
        6|update-sudoer-request) COMMAND=update-sudoer-request ;;
        7|remove-sudoer-request) COMMAND=remove-sudoer-request ;;
        8|list-approving) COMMAND=list-approving ;;
        9|list-approved) COMMAND=list-approved ;;
        10|list-rejected) COMMAND=list-rejected ;;
        11|show) COMMAND=show ;;
        12|remove-lpu) COMMAND=remove-lpu ;;
        13|approve) COMMAND=approve ;;
        14|reject) COMMAND=reject ;;
        15|interactive) COMMAND=interactive ;;
        99|exit|quit|Exit) return 0 ;;
        *)
            out_die "Unknown choice '${_choice}'. Next: ${APP_NAME} menu"
            ;;
    esac
    app_run_command
}

# =============================================================================
# app_run_command() - Dispatch COMMAND to the live handler
# =============================================================================
#
# GENERAL PURPOSE:
# Single case for the live dispatcher. app_main parses flags then calls this.
# app_main_menu sets COMMAND from a numbered choice then calls this.
#
# ALIGNMENT:
# - requirement-shell-cli-interface.md
# - requirement-shell-cli-default-interaction.md
#
# Last updated: 2026-09-03
# =============================================================================
app_run_command() {
    : "${COMMAND:=help}"
    case "${COMMAND}" in
        version)      app_version ;;
        about)        app_about ;;
        install)      inst_perform_install ;;
        version-check) ver_check ;;
        self-update)  inst_self_update ;;
        self-uninstall) inst_self_uninstall ;;
        menu|main)    app_main_menu ;;
        sudoers-to-json) sr_sudoers_to_json ;;
        json-to-sudoers) sr_json_to_sudoers ;;
        test-json-format) sr_test_json_format ;;
        test-well-known-binary) sr_test_well_known_binary ;;
        fence-test) sr_fence_test ;;
        rc-test)
            # shellcheck disable=SC2086
            set -- ${RC_TEST_OPERANDS}
            path_rc_test "$@"
            ;;
        print-sudoers) sr_print_sudoers ;;
        print-sudoers-install-script) sr_print_sudoers_install_script ;;
        add-sudoer-request)    sr_submit add ;;
        update-sudoer-request) sr_submit update ;;
        remove-sudoer-request) sr_submit remove ;;
        list-approving)  sr_list approving ;;
        list-approved)   sr_list approved ;;
        list-rejected)   sr_list rejected ;;
        show)            sr_show ;;
        approve)         sr_approve ;;
        reject)          sr_reject ;;
        interactive)     sr_interactive ;;
        setup)           lpu_setup ;;
        remove-lpu)      lpu_remove ;;
        help|*)          app_help ;;
    esac
}

# =============================================================================
# app_help() - Usage (Type 0 lifecycle + routed domain)
# =============================================================================
app_help() {
    : "${SHORT_DESCRIPTION:=${APP_DESC:-Least-privilege sudoers-request approval CLI}}"
    : "${DESCRIPTION:=POSIX /bin/sh CLI: install, version-check, self-update, self-uninstall, version, about, help.}"

    if [ "${JSON}" -eq 1 ]; then
        out_json "success" "Help text available in human-readable mode. Run without --json." \
            "command" "help" \
            "note" "Use --json with version, about, install, version-check, self-update, self-uninstall, rc-test."
        return 0
    fi
    if [ "${QUIET}" -eq 1 ]; then
        return 0
    fi

    out_info "${APP_NAME} — ${SHORT_DESCRIPTION}"
    out_plain "${DESCRIPTION}"
    out_empty_line
    out_info "Usage:"
    out_plain "  ${APP_NAME} [command] [options]"
    out_empty_line
    out_info "Install and keep this program:"
    out_plain "  install              Place ${APP_NAME} from the install channel (root→global, user→~/.local/bin)"
    out_plain "  install --global     Force global path (${GLOBAL_BIN}; needs write/root)"
    out_plain "  version-check        Compare local version to the install channel"
    out_plain "  self-update          Fetch a newer copy from the install channel"
    out_plain "  self-uninstall       Remove the managed binary (confirm or --force)"
    out_plain "  version              Show local version (no network)"
    out_plain "  about                Show diagnostics, channel, and resolved queue paths"
    out_plain "  menu / main          Numbered list of live work commands (real terminal)"
    out_plain "  help                 Show this help"
    out_empty_line
    out_info "Convert, queue, and list requests:"
    out_plain "  sudoers-to-json      Convert sudoers fragment to request JSON"
    out_plain "  json-to-sudoers      Convert request JSON to sudoers fragment"
    out_plain "  print-sudoers        Print the sudoers fragment that lets sudoer-adm review without a password"
    out_plain "  print-sudoers-install-script  Emit admin install script"
    out_plain "  add-sudoer-request   Queue an add request (JSON or sudoers)"
