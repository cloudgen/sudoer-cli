app_help() {
    : "${SHORT_DESCRIPTION:=${APP_DESC:-Local self-managed POSIX /bin/sh CLI (Type 0 lifecycle)}}"
    : "${DESCRIPTION:=POSIX /bin/sh CLI: install, uninstall, where-is-me, version, about, help.}"

    if [ "${JSON}" -eq 1 ]; then
        out_json "success" "Help text available in human-readable mode. Run without --json." \
            "command" "help" \
            "note" "Use --json with version, about, install, uninstall, where-is-me."
        return 0
    fi
    if [ "${QUIET}" -eq 1 ]; then
        return 0
    fi

    out_info "${APP_NAME} — ${SHORT_DESCRIPTION}"
    out_plain "${DESCRIPTION}"
    out_empty_line
    out_info "Usage:"
    out_plain "  ${APP_NAME} [command] [options]"
