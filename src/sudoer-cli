# =============================================================================
# app_about() - Diagnostics (Type 0 + resolved queue paths)
# =============================================================================
#
# ALIGNMENT:
# - requirement-shell-cli-interface.md
# - requirement-shell-cli-storage.md
#
# Last reviewed: 2026-08-13
# =============================================================================
app_about() {
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${APP_NAME:=sudoer-cli}"
    : "${VERSION:=1.1.0}"
    : "${REPO_USER:=cloudgen}"
    : "${REPO_NAME:=sudoer-cli}"
    : "${SCRIPT_URL:=}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${HOME:=/tmp}"
    : "${USER_BIN:=${HOME}/.local/bin}"
    : "${USERNAME:=unknown}"
    : "${XDG_CACHE_HOME:=${HOME}/.cache}"

    if [ -z "${EFFECTIVE_STORAGE_DIR:-}" ]; then
        EFFECTIVE_STORAGE_DIR=$(util_resolve_storage)
    fi
    : "${STORAGE_DIR:=${XDG_CACHE_HOME}/${APP_NAME}-${USERNAME}}"

    _installed="false"
    inst_is_installed && _installed="true"

    _global_ver="not found"
    if [ -x "${GLOBAL_BIN}/${APP_NAME}" ]; then
        _global_ver=$(grep '^VERSION="' "${GLOBAL_BIN}/${APP_NAME}" 2>/dev/null | cut -d'"' -f2 || echo "unknown")
    fi
    _local_ver="not found"
    if [ -x "${USER_BIN}/${APP_NAME}" ]; then
        _local_ver=$(grep '^VERSION="' "${USER_BIN}/${APP_NAME}" 2>/dev/null | cut -d'"' -f2 || echo "unknown")
    fi
    _shell=$(util_get_current_shell)
    _user=$(id -un 2>/dev/null || echo "unknown")
    _interactive="false"
    [ "${TTY:-0}" -eq 1 ] && _interactive="true"

    if [ "${JSON}" -eq 1 ]; then
        sr_resolve_queues 2>/dev/null || true
        out_json "about" "" \
            "app" "${APP_NAME}" \
            "version" "${VERSION}" \
            "repo_user" "${REPO_USER}" \
            "repo_name" "${REPO_NAME}" \
            "repository" "${REPO_USER}/${REPO_NAME}" \
            "script_url" "${SCRIPT_URL}" \
            "installed" "${_installed}" \
            "global_version" "${_global_ver}" \
            "local_version" "${_local_ver}" \
            "shell" "${_shell}" \
            "interactive" "${_interactive}" \
            "user" "${_user}" \
            "effective_storage" "${EFFECTIVE_STORAGE_DIR}" \
            "storage_dir" "${STORAGE_DIR}" \
            "queue_request" "${SUDOER_QUEUE_REQUEST:-}" \
            "queue_approved" "${SUDOER_QUEUE_APPROVED:-}" \
            "queue_rejected" "${SUDOER_QUEUE_REJECTED:-}"
        return 0
    fi

    [ "${QUIET}" -eq 1 ] && return 0

    out_info "=== ${APP_NAME} ${VERSION} - About / Diagnostics ==="
    out_empty_line
    if [ "${_installed}" = "true" ]; then
        out_success "${APP_NAME} is properly installed."
    else
        out_warn "${APP_NAME} is NOT installed in a managed bin path."
        out_info "   Recommended: ${APP_NAME} install   (local copy → ${USER_BIN}/${APP_NAME})"
    fi
    out_empty_line
    out_info "Global install  (${GLOBAL_BIN}/${APP_NAME}):   ${_global_ver}"
    out_info "Local install   (${USER_BIN}/${APP_NAME}):    ${_local_ver}"
    out_empty_line
    out_info "Repository:        ${REPO_USER}/${REPO_NAME}"
    if [ -n "${SCRIPT_URL}" ]; then
        out_info "Install channel:   ${SCRIPT_URL}"
    else
        out_info "Install channel:   (empty — local install only)"
    fi
    out_empty_line
    out_info "Current user:      ${_user}"
    if [ "$(id -u)" -eq 0 ]; then
        out_success "Execution context: root"
    else
        out_info "Execution context: normal user (Type 0 lifecycle)"
    fi
    out_empty_line
    out_info "Current shell:     ${_shell}"
    if [ "${TTY:-0}" -eq 1 ]; then
        out_info "TTY / Interactive: yes"
    else
        out_info "TTY / Interactive: no"
    fi
    out_empty_line
    out_info "Storage (effective): ${EFFECTIVE_STORAGE_DIR}"
    out_info "Storage (fallback):  ${STORAGE_DIR}"
    sr_resolve_queues 2>/dev/null || true
    out_info "Queue request:       ${SUDOER_QUEUE_REQUEST:-}"
    out_info "Queue approved:      ${SUDOER_QUEUE_APPROVED:-}"
    out_info "Queue rejected:      ${SUDOER_QUEUE_REJECTED:-}"
    out_empty_line
    out_info "Useful commands:"
    out_info "   ${APP_NAME} help            → Full usage"
    out_info "   ${APP_NAME} install         → Local install to ~/.local/bin"
    out_info "   ${APP_NAME} --json          → Machine-readable output"
}

# =============================================================================
# Domain: sudoers-request (requirement-domain-sudoer-approval.md)
# Prefixes: sr_ (requests) · lpu_ (setup/teardown)
# =============================================================================

sr_abs_path() {
    case "${1-}" in
        /*) return 0 ;;
        *) return 1 ;;
    esac
}

sr_read_input() {
    if [ -n "${SR_FILE-}" ] && [ "${SR_FILE}" != "" ]; then
        [ -f "${SR_FILE}" ] || sr_die "not a regular file: ${SR_FILE}" "not_regular"
        [ -L "${SR_FILE}" ] && sr_die "refusing symlink input: ${SR_FILE}" "not_regular"
        cat "${SR_FILE}"
        return 0
    fi
    if [ -t 0 ]; then
        sr_die "provide --file PATH or stdin (xor)" "xor_input"
    fi
    cat
}

sr_write_payload() {
    _payload="$1"
    if [ -n "${SR_OUT-}" ]; then
        sr_abs_path "${SR_OUT}" || sr_die "output path must be absolute: ${SR_OUT}" "invalid_name"
        printf '%s\n' "${_payload}" >"${SR_OUT}" || sr_die "cannot write ${SR_OUT}" "invalid_name"
        if [ "${JSON}" -eq 1 ]; then
            out_json "success" "wrote payload" "command" "${COMMAND}" "out" "${SR_OUT}"
        else
            out_success "Wrote ${SR_OUT}"
        fi
        return 0
    fi
    if [ "${JSON}" -eq 1 ]; then
        out_json "success" "payload" "command" "${COMMAND}" "@body" "${_payload}"
        return 0
    fi
    printf '%s\n' "${_payload}"
}

sr_visudo_text() {
    _vt="$1"
    if ! command -v visudo >/dev/null 2>&1; then
        out_debug "visudo not present; skip visudo -cf"
        return 0
    fi
    _vf=$(mktemp "${TMPDIR:-/tmp}/sudoer-visudo.XXXXXX") || sr_die "mktemp failed" "visudo_fail"
    printf '%s\n' "${_vt}" >"${_vf}"
    if ! visudo -cf "${_vf}" >/dev/null 2>&1; then
        rm -f "${_vf}"
        _cmd=$(sr_operator_cmd)
        if [ -n "${SR_FILE-}" ]; then
            _next="${_cmd} json-to-sudoers --file ${SR_FILE}"
        else
            _next="${_cmd} help"
        fi
        sr_die "The sudoers text failed host validation. Do not approve this grant. Fix the spec and convert again." "visudo_fail" \
            "${_next}"
    fi
    rm -f "${_vf}"
}

sr_json_get_str() {
    _jg_json=$(printf '%s' "$1" | tr '\n' ' ')
    _jg_key="$2"
    printf '%s' "${_jg_json}" | sed -n "s/.*\"${_jg_key}\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p" | head -n1
}

sr_json_has_key() {
    _jh_json=$(printf '%s' "$1" | tr '\n' ' ')
    _jh_key="$2"
    case "${_jh_json}" in
        *"\"${_jh_key}\""*) return 0 ;;
        *) return 1 ;;
    esac
}

sr_json_encode_request() {
    _je_purpose="$1"
    _je_user="$2"
    _je_svc="$3"
    _je_act="$4"
    _je_cmds="$5"
    if [ "${_je_act}" = "remove" ]; then
        # Purpose-only means no commands, not no subject. Dest uses JSON identity.
        printf '{"schema_version":1,"purpose":"%s","username":"%s","service":"%s","action":"remove"}' \
            "$(util_json_escape "${_je_purpose}")" \
            "$(util_json_escape "${_je_user}")" \
            "$(util_json_escape "${_je_svc}")"
        return 0
    fi
    _acc=""
    _first=1
    _tf=$(util_mktemp)
    printf '%s' "${_je_cmds}" >"${_tf}"
    while IFS='|' read -r _je_runas _je_tags _je_path _je_args || [ -n "${_je_path-}" ]; do
        [ -n "${_je_path}" ] || continue
        _je_tagjson="[]"
        [ "${_je_tags}" = "NOPASSWD" ] && _je_tagjson='["NOPASSWD"]'
        _je_argjson="["
        _je_af=1
        for _je_a in ${_je_args}; do
            [ "${_je_af}" -eq 1 ] || _je_argjson="${_je_argjson},"
            _je_argjson="${_je_argjson}\"$(util_json_escape "${_je_a}")\""
            _je_af=0
        done
        _je_argjson="${_je_argjson}]"
        _obj=$(printf '{"runas":"%s","tags":%s,"path":"%s","args":%s}' \
            "$(util_json_escape "${_je_runas:-root}")" \
            "${_je_tagjson}" \
            "$(util_json_escape "${_je_path}")" \
            "${_je_argjson}")
        if [ "${_first}" -eq 1 ]; then
            _acc="${_obj}"
            _first=0
        else
            _acc="${_acc},${_obj}"
        fi
    done <"${_tf}"
    rm -f "${_tf}"
    : "${APP_NAME:=sudoer-cli}"
    : "${VERSION:=1.16.0}"
    printf '{"schema_version":1,"purpose":"%s","username":"%s","service":"%s","action":"%s","submit_app":"%s","submit_version":"%s","commands":[%s]}' \
        "$(util_json_escape "${_je_purpose}")" \
        "$(util_json_escape "${_je_user}")" \
        "$(util_json_escape "${_je_svc}")" \
        "$(util_json_escape "${_je_act}")" \
        "$(util_json_escape "${APP_NAME}")" \
        "$(util_json_escape "${VERSION}")" \
        "${_acc}"
}

sr_parse_sudoers() {
    # Sets SR_P_PURPOSE, SR_P_USER, SR_P_CMDS (path|tags|runas|args lines via runas|tags|path|args)
    SR_P_PURPOSE=""
    SR_P_USER=""
    SR_P_CMDS=""
    _in_hdr=1
    _hdr=""
    _cmds=""
    _user=""
    _pf=$(util_mktemp)
    printf '%s\n' "$1" >"${_pf}"
    while IFS= read -r _ln || [ -n "${_ln}" ]; do
        case "${_ln}" in
            "#"*)
                if [ "${_in_hdr}" -eq 1 ]; then
                    case "${_ln}" in
                        "# Purpose:"*|"# Purpose: "*)
                            _p="${_ln#\# Purpose:}"
                            _p="${_p# }"
                            _hdr="${_p}"
                            ;;
                    esac
                fi
                continue
                ;;
            "")
                [ "${_in_hdr}" -eq 1 ] && continue
                ;;
            *)
                _in_hdr=0
                ;;
        esac
        [ "${_in_hdr}" -eq 1 ] && continue
        # user ALL=(runas) [NOPASSWD:] path [args]
        _u=$(printf '%s' "${_ln}" | awk '{print $1}')
        case "${_ln}" in
            *" ALL="*) ;;
            *) sr_die "invalid sudoers spec: ${_ln}" "invalid_name" ;;
        esac
        [ "${_u}" = "ALL" ] && sr_die "User ALL forbidden" "self_scope"
        if [ -n "${_user}" ] && [ "${_user}" != "${_u}" ]; then
            sr_die "multiple User specs" "self_scope"
        fi
        _user="${_u}"
        _runas="root"
        case "${_ln}" in
            *ALL=\(*\)*)
                _runas=$(printf '%s' "${_ln}" | sed -n 's/.*ALL=(\([^)]*\)).*/\1/p')
                ;;
        esac
        _tags=""
        case "${_ln}" in
            *NOPASSWD:*) _tags="NOPASSWD" ;;
        esac
        _rest=$(printf '%s' "${_ln}" | sed 's/.*:[[:space:]]*//')
        _path=$(printf '%s' "${_rest}" | awk '{print $1}')
        _args=$(printf '%s' "${_rest}" | awk '{ $1=""; sub(/^ /,""); print }')
        case "${_path}" in
            /*) ;;
            *) sr_die "Cmnd must be absolute: ${_path}" "invalid_name" ;;
        esac
        [ "${_path}" = "ALL" ] && sr_die "Cmnd ALL forbidden" "invalid_name"
        _cmds="${_cmds}${_runas}|${_tags}|${_path}|${_args}
"
    done <"${_pf}"
    rm -f "${_pf}"
    SR_P_PURPOSE="${_hdr}"
    SR_P_USER="${_user}"
    SR_P_CMDS="${_cmds}"
}

sr_render_sudoers() {
    _rr_purpose="$1"
    _rr_user="$2"
    _rr_act="$3"
    _rr_cmds="$4"
    printf '# Purpose: %s\n' "${_rr_purpose}"
    [ "${_rr_act}" = "remove" ] && return 0
    _tf=$(util_mktemp)
    printf '%s' "${_rr_cmds}" >"${_tf}"
    while IFS='|' read -r _runas _tags _path _args || [ -n "${_path-}" ]; do
        [ -n "${_path}" ] || continue
        _tagp=""
        [ "${_tags}" = "NOPASSWD" ] && _tagp="NOPASSWD: "
        if [ -n "${_args}" ]; then
            printf '%s ALL=(%s) %s%s %s\n' "${_rr_user}" "${_runas}" "${_tagp}" "${_path}" "${_args}"
        else
            printf '%s ALL=(%s) %s%s\n' "${_rr_user}" "${_runas}" "${_tagp}" "${_path}"
        fi
    done <"${_tf}"
    rm -f "${_tf}"
}

sr_valid_service_name() {
    printf '%s' "$1" | grep -Eq '^[a-z][a-z0-9-]{0,31}$'
}

sr_service_infer() {
    _si_cmds="$1"
    _si_force="${2-}"
    _hit=""
    _unclass=0
    _tf=$(util_mktemp)
    printf '%s' "${_si_cmds}" >"${_tf}"
    while IFS='|' read -r _runas _tags _path _args || [ -n "${_path-}" ]; do
        [ -n "${_path}" ] || continue
        _fam=""
        case "${_path}" in
            */nginx) _fam="webservice" ;;
            */gitlab-ctl) _fam="gitlab" ;;
            */systemctl)
                case " ${_args} " in
                    *" nginx "*) _fam="webservice" ;;
                esac
                ;;
            */journalctl)
                case " ${_args} " in
                    *" -u nginx "*|*" nginx "*) _fam="webservice" ;;
                    *" gitlab-"*) _fam="gitlab" ;;
                esac
                ;;
        esac
        if [ -z "${_fam}" ]; then
            _unclass=1
            continue
        fi
        if [ -n "${_hit}" ] && [ "${_hit}" != "${_fam}" ]; then
            rm -f "${_tf}"
            _cmd=$(sr_operator_cmd)
            sr_die "This grant mixes commands from more than one service. Use one service per request." "unknown_service" \
                "${_cmd} sudoers-to-json --file <one-service.sudoers> --action add --purpose '...'"
        fi
        _hit="${_fam}"
    done <"${_tf}"
    rm -f "${_tf}"
    _cmd=$(sr_operator_cmd)
    if [ -n "${_hit}" ] && [ "${_unclass}" -eq 1 ]; then
        sr_die "This grant mixes commands from more than one service. Use one service per request." "unknown_service" \
            "${_cmd} sudoers-to-json --file <one-service.sudoers> --action add --purpose '...'"
    fi
    if [ -n "${_si_force}" ]; then
        sr_valid_service_name "${_si_force}" || sr_die "Service name '${_si_force}' is not allowed. Use lowercase letters, digits, and hyphens (for example folder-backup)." "unknown_service" \
            "${_cmd} sudoers-to-json --file <fragment.sudoers> --action add --purpose '...' --service folder-backup"
        if [ -n "${_hit}" ] && [ "${_si_force}" != "${_hit}" ]; then
            sr_die "The --service name does not match the commands in this file." "unknown_service" \
                "${_cmd} sudoers-to-json --file <fragment.sudoers> --action add --purpose '...'"
        fi
        SR_INFERRED="${_si_force}"
        return 0
    fi
    [ -n "${_hit}" ] || sr_die "Cannot tell which service these commands belong to. Name the product with --service (for example folder-backup)." "unknown_service" \
        "${_cmd} sudoers-to-json --file <fragment.sudoers> --action add --purpose '...' --service folder-backup"
    SR_INFERRED="${_hit}"
}

# Split {{service}}-{{username}} from a request-id middle (hyphenated services first).
sr_split_service_user() {
    _mid="$1"
    SR_ID_SVC=""
    SR_ID_USER=""
    # Longest known hyphenated services first (project-sudoers-file style APP_NAME).
    for _ks in folder-backup webservice gitlab; do
        case "${_mid}" in
            "${_ks}"-?*)
                SR_ID_SVC="${_ks}"
                SR_ID_USER="${_mid#"${_ks}"-}"
                [ -n "${SR_ID_USER}" ] || continue
                return 0
                ;;
        esac
    done
    case "${_mid}" in
        *-*)
            SR_ID_USER="${_mid##*-}"
            SR_ID_SVC="${_mid%-"${SR_ID_USER}"}"
            if [ -n "${SR_ID_SVC}" ] && [ -n "${SR_ID_USER}" ]; then
                return 0
            fi
            ;;
    esac
    sr_die "cannot parse service-user: ${_mid}" "invalid_name"
}

# Parse sudoer-{{yyyyMMdd}}-{{service}}-{{username}}-{{action}}-{{n}}.json
sr_parse_request_id() {
    _bn="$1"
    SR_ID_DATE=""
    SR_ID_SVC=""
    SR_ID_USER=""
    SR_ID_ACT=""
    SR_ID_N=""
    case "${_bn}" in
        sudoer-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-*.json) ;;
        *) sr_die "invalid request_id: ${_bn}" "invalid_name" ;;
    esac
    _stem="${_bn#sudoer-}"
    _stem="${_stem%.json}"
    _date="${_stem%%-*}"
    case "${_date}" in
        [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]) ;;
        *) sr_die "invalid request date: ${_bn}" "invalid_name" ;;
    esac
    _rest="${_stem#"${_date}"-}"
    _n="${_rest##*-}"
    case "${_n}" in
        [1-9]|[1-9][0-9]|[1-9][0-9][0-9]) ;;
        *) sr_die "invalid request sequence: ${_bn}" "invalid_name" ;;
    esac
    _head="${_rest%-"${_n}"}"
    _act="${_head##*-}"
    case "${_act}" in
        add|update|remove) ;;
        *) sr_die "invalid request action: ${_bn}" "invalid_name" ;;
    esac
    _mid="${_head%-"${_act}"}"
    [ -n "${_mid}" ] || sr_die "invalid request_id: ${_bn}" "invalid_name"
    sr_split_service_user "${_mid}"
    sr_valid_service_name "${SR_ID_SVC}" || sr_die "invalid service in request_id: ${SR_ID_SVC}" "invalid_name"
    printf '%s' "${SR_ID_USER}" | grep -Eq '^[a-z_][a-z0-9_-]*$' || \
        sr_die "invalid username in request_id: ${SR_ID_USER}" "invalid_name"
    SR_ID_DATE="${_date}"
    SR_ID_ACT="${_act}"
    SR_ID_N="${_n}"
}

sr_json_decode_to_fields() {
    _jd="$1"
    SR_D_PURPOSE=$(sr_json_get_str "${_jd}" "purpose")
    SR_D_USER=$(sr_json_get_str "${_jd}" "username")
    SR_D_SVC=$(sr_json_get_str "${_jd}" "service")
    SR_D_ACT=$(sr_json_get_str "${_jd}" "action")
    SR_D_KIND=$(sr_json_get_str "${_jd}" "kind")
    : "${SR_D_KIND:=}"
    SR_D_SUBMIT_BY=$(sr_json_get_str "${_jd}" "submit_by")
    : "${SR_D_SUBMIT_BY:=}"
    SR_D_SUBMIT_APP=$(sr_json_get_str "${_jd}" "submit_app")
    : "${SR_D_SUBMIT_APP:=}"
    SR_D_SUBMIT_VERSION=$(sr_json_get_str "${_jd}" "submit_version")
    : "${SR_D_SUBMIT_VERSION:=}"
    SR_D_VER=$(sr_json_get_str "${_jd}" "schema_version")
    [ -n "${SR_D_VER}" ] || SR_D_VER=$(printf '%s' "${_jd}" | tr '\n' ' ' | sed -n 's/.*"schema_version"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p')
    if sr_json_has_key "${_jd}" "commands"; then
        SR_D_HAS_CMDS=1
    else
        SR_D_HAS_CMDS=0
    fi
    SR_D_CMDS=""
    if [ "${SR_D_HAS_CMDS}" -eq 1 ]; then
        _block=$(printf '%s' "${_jd}" | tr '\n' ' ' | sed -n 's/.*"commands"[[:space:]]*:[[:space:]]*\[\(.*\)\].*/\1/p')
        _cf=$(util_mktemp)
        # Pretty or compact: split objects on "}" + optional space + "," + optional space + "{".
        # Token "},{" alone drops indented / spaced arrays (INC-20260817-001).
        printf '%s' "${_block}" | sed 's/}[[:space:]]*,[[:space:]]*{/}\n{/g' >"${_cf}"
        while IFS= read -r _obj || [ -n "${_obj}" ]; do
            [ -n "${_obj}" ] || continue
            _p=$(sr_json_get_str "${_obj}" "path")
            _r=$(sr_json_get_str "${_obj}" "runas")
            [ -n "${_r}" ] || _r="root"
            _t=""
            case "${_obj}" in
                *NOPASSWD*) _t="NOPASSWD" ;;
            esac
            _args=""
            _ab=$(printf '%s' "${_obj}" | sed -n 's/.*"args"[[:space:]]*:[[:space:]]*\[\([^]]*\)\].*/\1/p')
            _ab=$(printf '%s' "${_ab}" | tr ',' ' ' | tr -d '"' | awk '{$1=$1; print}')
            SR_D_CMDS="${SR_D_CMDS}${_r}|${_t}|${_p}|${_ab}
"
        done <"${_cf}"
        rm -f "${_cf}"
        _n_path=$(printf '%s' "${_block}" | awk 'BEGIN{n=0} {n+=gsub(/"path"/,"")} END{print n+0}')
        _n_cmd=0
        if [ -n "${SR_D_CMDS}" ]; then
            _n_cmd=$(printf '%s' "${SR_D_CMDS}" | awk 'NF{c++} END{print c+0}')
        fi
        if [ "${_n_path}" -gt 0 ] && [ "${_n_cmd}" -ne "${_n_path}" ]; then
            _cmd=$(sr_operator_cmd)
            if [ -n "${SR_FILE-}" ]; then
                _next="${_cmd} json-to-sudoers --file ${SR_FILE}"
            else
                _next="${_cmd} json-to-sudoers --file <request.json>"
            fi
            sr_die "This request JSON is incomplete: it lists ${_n_path} commands but only ${_n_cmd} could be read. Do not approve it. Pretty or compact JSON are both OK — fix the file and convert or submit again." "invalid_json" \
                "${_next}"
        fi
    fi
}

sr_sudoers_to_json() {
    _raw=$(sr_read_input)
    case "${_raw}" in
        *"ALL=(ALL) ALL"*|*"NOPASSWD: ALL"*) sr_die "broad rights forbidden" "invalid_name" ;;
        *"#include"*) sr_die "#include forbidden" "invalid_name" ;;
        *"Defaults"*) sr_die "Defaults forbidden" "invalid_name" ;;
    esac
    sr_parse_sudoers "${_raw}"
    _act="${SR_ACTION:-add}"
    case "${_act}" in
        add|update) ;;
        *) sr_die "--action add|update required" "xor_input" ;;
    esac
    _purpose="${SR_PURPOSE:-${SR_P_PURPOSE}}"
    [ -n "${_purpose}" ] || sr_die "--purpose required when input has no # Purpose:" "xor_input"
    [ -n "${SR_P_USER}" ] || sr_die "no User spec in sudoers" "invalid_json"
    sr_cmds_require_well_known "${SR_P_CMDS}" "convert" \
        "$(sr_operator_cmd) test-well-known-binary --file request.json"
    sr_service_infer "${SR_P_CMDS}" "${SR_SERVICE-}"
    _svc="${SR_INFERRED}"
    _txt=$(sr_render_sudoers "${_purpose}" "${SR_P_USER}" "${_act}" "${SR_P_CMDS}")
    sr_visudo_text "${_txt}"
    _js=$(sr_json_encode_request "${_purpose}" "${SR_P_USER}" "${_svc}" "${_act}" "${SR_P_CMDS}")
    sr_write_payload "${_js}"
}

sr_json_to_sudoers() {
    _raw=$(sr_read_input)
    _trim=$(printf '%s' "${_raw}" | sed 's/^[[:space:]]*//')
    case "${_trim}" in
        "{"*) ;;
        *) sr_die "expected JSON object" "invalid_json" ;;
    esac
    sr_json_decode_to_fields "${_raw}"
    [ -n "${SR_D_PURPOSE}" ] || sr_die "purpose required" "invalid_json"
    _act="${SR_D_ACT:-remove}"
    if [ "${SR_D_HAS_CMDS}" -eq 1 ] && { [ "${_act}" = "remove" ] || [ -z "${SR_D_ACT}" ]; }; then
        if [ -z "${SR_D_ACT}" ] || [ "${SR_D_ACT}" = "remove" ]; then
            sr_die "remove JSON must not include commands" "remove_extra_fields"
        fi
    fi
    if [ "${_act}" = "remove" ] || { [ -z "${SR_D_ACT}" ] && [ "${SR_D_HAS_CMDS}" -eq 0 ]; }; then
        _txt=$(printf '# Purpose: %s\n' "${SR_D_PURPOSE}")
        sr_write_payload "${_txt}"
        return 0
    fi
    [ "${SR_D_VER}" = "1" ] || sr_die "schema_version must be 1" "schema_version"
    [ -n "${SR_D_USER}" ] || sr_die "username required" "invalid_json"
    [ -n "${SR_D_SVC}" ] || sr_die "service required" "invalid_json"
    [ -n "${SR_D_CMDS}" ] || sr_die "commands required for add/update" "invalid_json"
    sr_cmds_require_well_known "${SR_D_CMDS}" "convert" \
        "$(sr_operator_cmd) test-well-known-binary --file request.json"
    sr_service_infer "${SR_D_CMDS}" "${SR_D_SVC}"
    _svc="${SR_INFERRED}"
    _txt=$(sr_render_sudoers "${SR_D_PURPOSE}" "${SR_D_USER}" "${SR_D_ACT}" "${SR_D_CMDS}")
    sr_visudo_text "${_txt}"
    sr_write_payload "${_txt}"
}

sr_print_sudoers() {
    _gb="${GLOBAL_BIN:-/usr/local/bin}"
    _lpu="sudoer-adm"
    _txt=$(printf '# %s F6 Table A — production global binary\n%s ALL=(root) NOPASSWD: %s/%s\n' \
        "${APP_NAME}" "${_lpu}" "${_gb}" "${APP_NAME}")
    if [ -n "${SR_OUT-}" ]; then
        sr_write_payload "${_txt}"
        return 0
    fi
    if [ -n "${SR_OPERAND-}" ]; then
        SR_OUT="${SR_OPERAND}"
        sr_write_payload "${_txt}"
        return 0
    fi
    sr_write_payload "${_txt}"
}

sr_print_sudoers_install_script() {
    _script=$(mktemp "${TMPDIR:-/tmp}/${APP_NAME}.XXXXXX") || sr_die "mktemp failed" "invalid_name"
    _draft=$(mktemp "${TMPDIR:-/tmp}/${APP_NAME}.XXXXXX") || sr_die "mktemp failed" "invalid_name"
    _gb="${GLOBAL_BIN:-/usr/local/bin}"
    printf '# %s F6 Table A\n%s ALL=(root) NOPASSWD: %s/%s\n' \
        "${APP_NAME}" "sudoer-adm" "${_gb}" "${APP_NAME}" >"${_draft}"
    {
        printf '#!/bin/sh\nset -u\n'
        printf 'DRAFT="%s"\nINST="/etc/sudoers.d/sudoer-adm"\n' "${_draft}"
        printf 'cmd="${1-status}"\n'
        printf 'case "$cmd" in\n'
        printf '  status) ls -l "$DRAFT" "$INST" 2>/dev/null; exit 0 ;;\n'
        printf '  install) [ "$(id -u)" -eq 0 ] || exit 1; visudo -cf "$DRAFT" && install -m 0440 "$DRAFT" "$INST" ;;\n'
        printf '  uninstall) [ "$(id -u)" -eq 0 ] || exit 1; rm -f "$INST" ;;\n'
        printf '  replace) [ "$(id -u)" -eq 0 ] || exit 1; rm -f "$INST"; visudo -cf "$DRAFT" && install -m 0440 "$DRAFT" "$INST" ;;\n'
        printf '  *) echo "usage: $0 install|uninstall|replace|status" >&2; exit 1 ;;\n'
        printf 'esac\n'
    } >"${_script}"
    util_chmod 0700 "${_script}" 2>/dev/null || true
    if [ "${JSON}" -eq 1 ]; then
        out_json "success" "admin script" "script_path" "${_script}" "draft" "${_draft}"
    else
        out_success "Admin script: ${_script}"
        out_info "Draft: ${_draft}"
        out_info "sudo sh ${_script} install|uninstall|replace|status"
    fi
}

sr_default_public_queue_root() {
    : "${APP_NAME:=sudoer-cli}"
    printf '/var/%s' "${APP_NAME}"
}

# Live F3 = passwd home of LPU_USER. Create default stays in lpu_defaults.
lpu_resolve_home() {
    lpu_defaults
    _pw=$(getent passwd "${LPU_USER}" 2>/dev/null || true)
    if [ -n "${_pw}" ]; then
        _h=$(printf '%s' "${_pw}" | cut -d: -f6)
        if [ -n "${_h}" ]; then
            LPU_HOME="${_h}"
        fi
    fi
}

sr_resolve_queues() {
    : "${SUDOER_CLI_ALLOW_TEST_ROOTS:=0}"
    : "${APP_NAME:=sudoer-cli}"
    lpu_defaults
    lpu_resolve_home
    _root="${SR_QUEUE_ROOT:-${SUDOER_CLI_QUEUE_ROOT-}}"
    if [ -n "${_root}" ]; then
        sr_abs_path "${_root}" || sr_die "queue root must be absolute" "invalid_name"
        SUDOER_PUBLIC_QUEUE_ROOT="${_root}"
    else
        SUDOER_PUBLIC_QUEUE_ROOT=$(sr_default_public_queue_root)
    fi
    SUDOER_QUEUE_REQUEST="${SUDOER_PUBLIC_QUEUE_ROOT}/sudoer-request"
    SUDOER_QUEUE_APPROVED="${SUDOER_PUBLIC_QUEUE_ROOT}/sudoer-approved"
    SUDOER_QUEUE_REJECTED="${SUDOER_PUBLIC_QUEUE_ROOT}/sudoer-rejected"
    SUDOER_QUEUE_REQUEST_VIEW="${LPU_HOME}/sudoer-request"
    SUDOER_QUEUE_APPROVED_VIEW="${LPU_HOME}/sudoer-approved"
    SUDOER_QUEUE_REJECTED_VIEW="${LPU_HOME}/sudoer-rejected"
    [ -n "${SR_REQUEST_DIR:-${SUDOER_CLI_REQUEST_DIR-}}" ] && \
        SUDOER_QUEUE_REQUEST="${SR_REQUEST_DIR:-${SUDOER_CLI_REQUEST_DIR}}"
    [ -n "${SR_APPROVED_DIR:-${SUDOER_CLI_APPROVED_DIR-}}" ] && \
        SUDOER_QUEUE_APPROVED="${SR_APPROVED_DIR:-${SUDOER_CLI_APPROVED_DIR}}"
    [ -n "${SR_REJECTED_DIR:-${SUDOER_CLI_REJECTED_DIR-}}" ] && \
        SUDOER_QUEUE_REJECTED="${SR_REJECTED_DIR:-${SUDOER_CLI_REJECTED_DIR}}"
    for _q in "${SUDOER_QUEUE_REQUEST}" "${SUDOER_QUEUE_APPROVED}" "${SUDOER_QUEUE_REJECTED}"; do
        sr_abs_path "${_q}" || sr_die "queue path must be absolute: ${_q}" "invalid_name"
        if [ -L "${_q}" ]; then
            sr_die "queue last component must not be a symlink: ${_q}" "invalid_name"
        fi
    done
    if [ "${SUDOER_QUEUE_REQUEST}" = "${SUDOER_QUEUE_APPROVED}" ] || \
       [ "${SUDOER_QUEUE_REQUEST}" = "${SUDOER_QUEUE_REJECTED}" ] || \
       [ "${SUDOER_QUEUE_APPROVED}" = "${SUDOER_QUEUE_REJECTED}" ]; then
        sr_die "queue directories must be distinct" "invalid_name"
    fi
    export SUDOER_PUBLIC_QUEUE_ROOT \
        SUDOER_QUEUE_REQUEST SUDOER_QUEUE_APPROVED SUDOER_QUEUE_REJECTED \
        SUDOER_QUEUE_REQUEST_VIEW SUDOER_QUEUE_APPROVED_VIEW SUDOER_QUEUE_REJECTED_VIEW
}

# Type 0 submit uses the public real dir. Type 1 approve/reject/interactive
# uses ${LPU_HOME}/… views (symlinks) unless a queue override is in force.
sr_queue_override_set() {
    if [ -n "${SR_QUEUE_ROOT:-${SUDOER_CLI_QUEUE_ROOT-}}" ]; then
        return 0
    fi
    if [ -n "${SR_REQUEST_DIR:-${SUDOER_CLI_REQUEST_DIR-}}" ]; then
        return 0
    fi
    if [ -n "${SR_APPROVED_DIR:-${SUDOER_CLI_APPROVED_DIR-}}" ]; then
        return 0
    fi
    if [ -n "${SR_REJECTED_DIR:-${SUDOER_CLI_REJECTED_DIR-}}" ]; then
        return 0
    fi
    return 1
}

sr_approver_dir() {
    _which="$1"
    if sr_queue_override_set; then
        case "${_which}" in
            request)  printf '%s' "${SUDOER_QUEUE_REQUEST}" ;;
            approved) printf '%s' "${SUDOER_QUEUE_APPROVED}" ;;
            rejected) printf '%s' "${SUDOER_QUEUE_REJECTED}" ;;
            *) sr_die "bad approver dir" "invalid_name" ;;
        esac
        return 0
    fi
    case "${_which}" in
        request)  printf '%s' "${SUDOER_QUEUE_REQUEST_VIEW}" ;;
        approved) printf '%s' "${SUDOER_QUEUE_APPROVED_VIEW}" ;;
        rejected) printf '%s' "${SUDOER_QUEUE_REJECTED_VIEW}" ;;
        *) sr_die "bad approver dir" "invalid_name" ;;
    esac
}

sr_require_approver_views() {
    if sr_queue_override_set; then
        return 0
    fi
    _cmd=$(sr_operator_cmd)
    for _v in "${SUDOER_QUEUE_REQUEST_VIEW}" "${SUDOER_QUEUE_APPROVED_VIEW}" "${SUDOER_QUEUE_REJECTED_VIEW}"; do
        if [ ! -L "${_v}" ]; then
            sr_die "approver queue view is missing (run setup): ${_v}" "not_found" \
                "sudo ${_cmd} setup"
        fi
    done
}

sr_chown_request_to_lpu() {
    lpu_defaults
    _rf="$1"
    if [ ! -f "${_rf}" ]; then
        sr_die "cannot chown missing request ${_rf}" "not_found"
    fi
    if [ -L "${_rf}" ]; then
        sr_die "not a regular file" "not_regular"
    fi
    if ! chown "${LPU_USER}:${LPU_USER}" "${_rf}"; then
        sr_die "cannot chown ${_rf} to ${LPU_USER}:${LPU_USER}" "authz"
    fi
    util_chmod 0640 "${_rf}" || true
}

sr_request_owner() {
    stat -c '%U' "$1" 2>/dev/null
}

# Dest-written submit_by = original Unix owner before dest took the file.
# Type 0 must not plant this key. Dest must not fence when it is present or missing.
sr_type0_forbid_submit_by() {
    if sr_json_has_key "$1" "submit_by"; then
        _cmd=$(sr_operator_cmd)
        sr_die "This grant JSON includes submit_by. That field is written by dest after it checks the waiting file. Do not plant it when you queue." "invalid_json" \
            "${_cmd} test-json-format --file request.json"
    fi
}

sr_stamp_submit_by() {
    _sf="$1"
    _so="$2"
    [ -n "${_sf}" ] && [ -n "${_so}" ] || return 0
    [ -f "${_sf}" ] || return 0
    _esc=$(util_json_escape "${_so}")
    _body=$(cat "${_sf}")
    if sr_json_has_key "${_body}" "submit_by"; then
        _body=$(printf '%s' "${_body}" | sed "s/\"submit_by\"[[:space:]]*:[[:space:]]*\"[^\"]*\"/\"submit_by\":\"${_esc}\"/")
    else
        # First '{' in the whole body only. Pretty commands[] objects also start with '{'.
        _body=$(printf '%s\n' "${_body}" | awk -v owner="${_esc}" '
            BEGIN { done = 0 }
            {
                if (done == 0) {
                    n = index($0, "{")
                    if (n > 0) {
                        $0 = substr($0, 1, n - 1) "{\"submit_by\":\"" owner "\"," substr($0, n + 1)
                        done = 1
                    }
                }
                print
            }
        ')
    fi
    printf '%s\n' "${_body}" >"${_sf}"
}

sr_restrict_submitted_file() {
    util_chmod 0640 "$1" || true
}

# Snapshot inbound to a private file, then place that snapshot in the
# archive dir and unlink the inbound name (do not mv a replaceable path).
sr_archive_validated() {
    lpu_defaults
    _snap="$1"
    _adir="$2"
    _aid="$3"
    _inb="$4"
    if ! cp "${_snap}" "${_adir}/${_aid}"; then
        rm -f "${_snap}"
        sr_die "cannot archive ${_aid}" "authz"
    fi
    if ! chown "${LPU_USER}:${LPU_USER}" "${_adir}/${_aid}"; then
        rm -f "${_snap}"
        sr_die "cannot chown archived ${_aid} to ${LPU_USER}:${LPU_USER}" "authz"
    fi
    util_chmod 0640 "${_adir}/${_aid}" || true
    rm -f "${_inb}"
    rm -f "${_snap}"
}

sr_require_queues() {
    sr_resolve_queues
    for _q in "${SUDOER_QUEUE_REQUEST}" "${SUDOER_QUEUE_APPROVED}" "${SUDOER_QUEUE_REJECTED}"; do
        if [ ! -d "${_q}" ]; then
            if [ "${SUDOER_CLI_ALLOW_TEST_ROOTS}" = "1" ]; then
                mkdir -p "${_q}" || sr_die "cannot create ${_q}" "invalid_name"
            else
                _cmd=$(sr_operator_cmd)
                sr_die "queue directory does not exist: ${_q}. Create the LPU first." "not_found" \
                    "sudo ${_cmd} setup"
            fi
        fi
    done
}

sr_alloc_request_id() {
    _au="$1"; _as="$2"; _aa="$3"
    sr_valid_service_name "${_as}" || sr_die "invalid service name: ${_as}" "unknown_service"
    _ad=$(date +%Y%m%d)
    _n=1
    while [ "${_n}" -le 999 ]; do
        _id="sudoer-${_ad}-${_as}-${_au}-${_aa}-${_n}.json"
        if [ ! -e "${SUDOER_QUEUE_REQUEST}/${_id}" ] && \
           [ ! -e "${SUDOER_QUEUE_APPROVED}/${_id}" ] && \
           [ ! -e "${SUDOER_QUEUE_REJECTED}/${_id}" ]; then
            printf '%s' "${_id}"
            return 0
        fi
        _n=$((_n + 1))
    done
    sr_die "daily sequence cap 999" "invalid_name"
}

sr_sidecar_path() {
    _st="${XDG_STATE_HOME:-${HOME}/.local/state}/${APP_NAME}"
    mkdir -p "${_st}" 2>/dev/null || true
    printf '%s' "${_st}/submitted.ids"
}

sr_sidecar_add() {
    _sp=$(sr_sidecar_path)
    printf '%s\n' "$1" >>"${_sp}"
    util_chmod 0600 "${_sp}" 2>/dev/null || true
}

sr_sidecar_has() {
    _sp=$(sr_sidecar_path)
    [ -f "${_sp}" ] || return 1
    grep -qx "$1" "${_sp}" 2>/dev/null
}

sr_sudoers_d_dir() {
    printf '%s' "${SUDOERS_D:-/etc/sudoers.d}"
}

sr_grant_root() {
    printf '%s' "${SUDOER_CLI_GRANT_ROOT:-${GRANT_ROOT:-/etc}}"
}

sr_user_tree() {
    # $1 username → /etc/{{username}} (LPU home / queues; not live sudo dest)
    printf '%s/%s' "$(sr_grant_root)" "$1"
}

sr_dest_basename() {
    # $1 username $2 service → {{service}}-{{username}}
    printf '%s-%s' "$2" "$1"
}

sr_grant_dest() {
    # $1 username $2 service → /etc/sudoers.d/{{service}}-{{username}}
    printf '%s/%s' "$(sr_sudoers_d_dir)" "$(sr_dest_basename "$1" "$2")"
}

# Never write /etc/passwd or /etc/sudoers. Product exception: Type 1 may
# copy / overwrite / remove product-owned names under /etc/sudoers.d/.
sr_forbid_passwd_or_main_sudoers() {
    _fp="$1"
    case "${_fp}" in
        /etc/passwd|/etc/group|/etc/shadow|/etc/gshadow|/etc/sudoers)
            sr_die "refusing to write ${_fp} (use useradd/userdel; sudoers dest is /etc/sudoers.d/<product-name>)." "authz"
            ;;
    esac
}

sr_require_product_sudoers_d() {
    # $1 path — allow F6 ({{LPU_USER}}) or grant ({{service}}-{{username}}); refuse foreign.
    lpu_defaults
    _fp="$1"
    _dir=$(sr_sudoers_d_dir)
    _base=$(basename "${_fp}")
    case "${_fp}" in
        "${_dir}"/"${LPU_USER}") return 0 ;;
        "${_dir}"/*-remove) sr_die "refusing dest ${_fp} (never install a *-remove name)." "authz" ;;
        "${_dir}"/*-*) return 0 ;;
    esac
    sr_die "refusing ${_fp} (not a product sudoers.d name; only copy/overwrite/remove F6 or {{service}}-{{user}})." "authz"
}

sr_detect_kind() {
    _dk=$(printf '%s' "$1" | sed 's/^[[:space:]]*//')
    case "${_dk}" in
        "{"*) printf 'json' ;;
        *) printf 'sudoers' ;;
    esac
}

sr_submit() {
    _act="$1"
    sr_require_queues
    _me=$(id -un)
    case "${_act}" in
        remove)
            [ -n "${SR_SERVICE-}" ] || sr_die "remove-sudoer-request requires --service" "xor_input"
            _user="${_me}"
            if [ -n "${SR_FILE-}" ]; then
                _raw=$(sr_read_input)
                sr_type0_forbid_submit_by "${_raw}"
                sr_json_decode_to_fields "${_raw}"
                [ -n "${SR_D_PURPOSE}" ] || sr_die "purpose required" "invalid_json"
                [ "${SR_D_HAS_CMDS}" -eq 0 ] || sr_die "remove JSON must not include commands" "remove_extra_fields"
                if [ -n "${SR_D_SVC}" ] && [ "${SR_D_SVC}" != "${SR_SERVICE}" ]; then
                    sr_die "JSON service does not match --service" "field_mismatch"
                fi
                if [ -n "${SR_D_ACT}" ] && [ "${SR_D_ACT}" != "remove" ]; then
                    sr_die "JSON action must be remove" "field_mismatch"
                fi
                _purpose="${SR_D_PURPOSE}"
                _user="${SR_D_USER:-${_me}}"
            else
                [ -n "${SR_PURPOSE-}" ] || sr_die "remove requires --purpose or --file" "xor_input"
                _purpose="${SR_PURPOSE}"
            fi
            _js=$(sr_json_encode_request "${_purpose}" "${_user}" "${SR_SERVICE}" "remove" "")
            _id=$(sr_alloc_request_id "${_user}" "${SR_SERVICE}" "remove")
            printf '%s\n' "${_js}" >"${SUDOER_QUEUE_REQUEST}/${_id}"
            sr_restrict_submitted_file "${SUDOER_QUEUE_REQUEST}/${_id}"
            sr_sidecar_add "${_id}"
            _dest=$(sr_grant_dest "${_user}" "${SR_SERVICE}")
            if [ "${JSON}" -eq 1 ]; then
                out_json "success" "submitted" "request_id" "${_id}" "dest" "${_dest}" "action" "remove"
            else
                out_success "request_id=${_id}"
            fi
            return 0
            ;;
    esac
    _raw=$(sr_read_input)
    _kind=$(sr_detect_kind "${_raw}")
    if [ "${_kind}" = "sudoers" ]; then
        sr_parse_sudoers "${_raw}"
        _purpose="${SR_PURPOSE:-${SR_P_PURPOSE}}"
        [ -n "${_purpose}" ] || sr_die "--purpose required when sudoers lacks # Purpose:" "xor_input"
        sr_cmds_require_well_known "${SR_P_CMDS}" "convert" \
            "$(sr_operator_cmd) test-well-known-binary --file request.json"
        sr_service_infer "${SR_P_CMDS}" "${SR_SERVICE-}"
        _svc="${SR_INFERRED}"
        _user="${SR_P_USER:-${_me}}"
        _js=$(sr_json_encode_request "${_purpose}" "${_user}" "${_svc}" "${_act}" "${SR_P_CMDS}")
    else
        sr_type0_forbid_submit_by "${_raw}"
        sr_json_decode_to_fields "${_raw}"
        [ -n "${SR_D_PURPOSE}" ] || sr_die "purpose required" "invalid_json"
        [ "${SR_D_ACT}" = "${_act}" ] || [ -z "${SR_D_ACT}" ] || sr_die "action mismatch" "field_mismatch"
        _svc="${SR_SERVICE:-${SR_D_SVC}}"
        [ -n "${_svc}" ] || sr_die "service required" "unknown_service"
        [ "${SR_D_HAS_CMDS}" -eq 1 ] || sr_die "commands required" "invalid_json"
        sr_cmds_require_well_known "${SR_D_CMDS}" "convert" \
            "$(sr_operator_cmd) test-well-known-binary --file request.json"
        sr_service_infer "${SR_D_CMDS}" "${_svc}"
        _svc="${SR_INFERRED}"
        _user="${SR_D_USER:-${_me}}"
        _js=$(sr_json_encode_request "${SR_D_PURPOSE}" "${_user}" "${_svc}" "${_act}" "${SR_D_CMDS}")
    fi
    _id=$(sr_alloc_request_id "${_user}" "${_svc}" "${_act}")
    printf '%s\n' "${_js}" >"${SUDOER_QUEUE_REQUEST}/${_id}"
    sr_restrict_submitted_file "${SUDOER_QUEUE_REQUEST}/${_id}"
    sr_sidecar_add "${_id}"
    _dest=$(sr_grant_dest "${_user}" "${_svc}")
    if [ "${JSON}" -eq 1 ]; then
        out_json "success" "submitted" "request_id" "${_id}" "dest" "${_dest}" "action" "${_act}"
    else
        out_success "request_id=${_id}"
    fi
}

sr_find_id() {
    _fid="$1"
    for _q in "${SUDOER_QUEUE_REQUEST}" "${SUDOER_QUEUE_APPROVED}" "${SUDOER_QUEUE_REJECTED}"; do
        if [ -f "${_q}/${_fid}" ]; then
            printf '%s' "${_q}/${_fid}"
            return 0
        fi
    done
    return 1
}

sr_list() {
    _which="$1"
    sr_require_queues
    case "${_which}" in
        approving) _dir="${SUDOER_QUEUE_REQUEST}" ;;
        approved)  _dir="${SUDOER_QUEUE_APPROVED}" ;;
        rejected)  _dir="${SUDOER_QUEUE_REJECTED}" ;;
        *) sr_die "bad list" "invalid_name" ;;
    esac
    _me=$(id -un)
    if [ "${SR_ORPHANS:-0}" -eq 1 ]; then
        sr_require_type1
        # orphans: non-regular inbound only
        for _f in "${_dir}"/sudoer-*.json; do
            [ -e "${_f}" ] || continue
            _bn=$(basename "${_f}")
            if [ -L "${_f}" ] || [ ! -f "${_f}" ]; then
                printf '%s\n' "${_bn}"
            fi
        done
        return 0
    fi
    if [ "$(id -u)" -eq 0 ]; then
        ls -1 "${_dir}" 2>/dev/null | grep '\.json$' || true
    else
        _sp=$(sr_sidecar_path)
        if [ -f "${_sp}" ]; then
            while IFS= read -r _id; do
                [ -f "${_dir}/${_id}" ] && printf '%s\n' "${_id}"
            done <"${_sp}"
        fi
    fi
}

sr_show() {
    _id="${SR_OPERAND-}"
    [ -n "${_id}" ] || sr_die "show requires request-id" "not_found"
    case "${_id}" in
        *.json) ;;
        *) sr_die "request-id must include .json" "invalid_name" ;;
    esac
    sr_require_queues
    if [ "$(id -u)" -ne 0 ]; then
        sr_sidecar_has "${_id}" || sr_die "unknown request_id" "not_found"
    fi
    _path=$(sr_find_id "${_id}") || sr_die "not found: ${_id}" "not_found"
    if [ "${JSON}" -eq 1 ]; then
        out_json "success" "show" "request_id" "${_id}" "path" "${_path}"
    fi
    cat "${_path}"
}

# Bootstrap Type 1 (setup / remove-lpu): any host admin who is already euid 0.
# Mix model: password sudo OK (human or in-tool). sudo -n is not suggested.
# First-time create cannot require sudoer-adm or sudo -n — F6 does not exist yet.
sr_require_type1_bootstrap() {
    if [ "$(id -u)" -ne 0 ]; then
        _who=$(id -un 2>/dev/null || echo "this user")
        _cmd=$(sr_operator_cmd)
        sr_die "setup must run as root. You are ${_who} (not root)." "authz" \
            "sudo ${_cmd} setup"
    fi
}

# Type 1 approve / reject / interactive: euid 0 only.
# Password sudo or a root login is the approval. F6 is an extra path.
sr_require_type1() {
    _cmd=$(sr_operator_cmd)
    _who=$(id -un 2>/dev/null || echo "this user")
    if [ "$(id -u)" -ne 0 ]; then
        sr_die "approve/reject/interactive must run as root. You are ${_who}." "authz" \
            "sudo ${_cmd} approve <request-id>     (password sudo OK)"
    fi
}

# Dest Fence: incorrect JSON format (requirement-incorrect-json-format).
# Username/service vs basename is not this Fence. Action vs basename is.
# Type 0 test-json-format uses the same body checks without dest elev.
sr_json_format_fence_die() {
    _happened="$1"
    _code="$2"
    _next="$3"
    _mode="${4:-dest}"
    if [ "${_mode}" = "test" ]; then
        sr_die "${_happened} It is not a well-formed grant JSON." "${_code}" "${_next}"
    else
        sr_die "${_happened} Dest will not ask yes/no. Do not approve it." "${_code}" "${_next}"
    fi
}

sr_dest_fence_unknown_keys() {
    _uk_body="$1"
    _uk_next="$2"
    _uk_mode="${3:-dest}"
    _uk_who="This waiting file"
    if [ "${_uk_mode}" = "test" ]; then
        _uk_who="This file"
    fi
    _uk_flat=$(printf '%s' "${_uk_body}" | tr '\n' ' ')
    _uk_flat=$(printf '%s' "${_uk_flat}" | sed 's/"commands"[[:space:]]*:[[:space:]]*\[.*\]/"commands":[]/')
    _uk_keys=$(printf '%s\n' "${_uk_flat}" | tr ',' '\n' | sed -n 's/^[[:space:]]*"\([a-z_][a-z0-9_]*\)"[[:space:]]*:.*/\1/p')
    for _uk in ${_uk_keys}; do
        case "${_uk}" in
            schema_version|purpose|username|service|action|commands|kind|submit_by|submit_app|submit_version) ;;
            *)
                sr_json_format_fence_die "${_uk_who} has an unexpected JSON field '${_uk}'." "invalid_json" \
                    "${_uk_next}" "${_uk_mode}"
                ;;
        esac
    done
}

sr_json_format_fence_or_die() {
    _jf_body="$1"
    _jf_next="$2"
    _jf_mode="${3:-dest}"
    _jf_fid="${4:-}"
    _jf_who="This waiting file"
    if [ "${_jf_mode}" = "test" ]; then
        _jf_who="This file"
    fi
    _trim=$(printf '%s' "${_jf_body}" | sed 's/^[[:space:]]*//')
    case "${_trim}" in
        "{"*) ;;
        *)
            sr_json_format_fence_die "${_jf_who} is not a grant JSON object." "invalid_json" \
                "${_jf_next}" "${_jf_mode}"
            ;;
    esac
    sr_json_decode_to_fields "${_jf_body}"
    sr_dest_fence_unknown_keys "${_jf_body}" "${_jf_next}" "${_jf_mode}"
    if [ -n "${SR_D_KIND}" ]; then
        case "${SR_D_KIND}" in
            type-2-switch|login-hook-elev) ;;
            *)
                sr_json_format_fence_die "${_jf_who} has an invalid kind '${SR_D_KIND}'." "invalid_json" \
                    "${_jf_next}" "${_jf_mode}"
                ;;
        esac
    fi
    if [ -n "${SR_D_ACT}" ]; then
        case "${SR_D_ACT}" in
            add|update|remove) ;;
            *)
                sr_json_format_fence_die "${_jf_who} has an invalid action '${SR_D_ACT}'." "invalid_json" \
                    "${_jf_next}" "${_jf_mode}"
                ;;
        esac
    fi
    if [ -n "${_jf_fid}" ]; then
        sr_parse_request_id "${_jf_fid}"
        if [ -n "${SR_D_ACT}" ] && [ "${SR_D_ACT}" != "${SR_ID_ACT}" ]; then
            sr_json_format_fence_die "${_jf_who}'s name says ${SR_ID_ACT} but the JSON action is ${SR_D_ACT}." "field_mismatch" \
                "${_jf_next}" "${_jf_mode}"
        fi
    fi
    [ -n "${SR_D_PURPOSE}" ] || sr_json_format_fence_die "${_jf_who} has no purpose." "invalid_json" \
        "${_jf_next}" "${_jf_mode}"
    _eff_act="${SR_D_ACT-}"
    if [ -z "${_eff_act}" ] && [ -n "${_jf_fid}" ]; then
        _eff_act="${SR_ID_ACT}"
    fi
    if [ "${_eff_act}" = "remove" ]; then
        [ "${SR_D_HAS_CMDS}" -eq 0 ] || sr_json_format_fence_die "${_jf_who} is a remove request that includes commands." "remove_extra_fields" \
            "${_jf_next}" "${_jf_mode}"
        if sr_json_has_key "${_jf_body}" "submit_app" && [ -z "${SR_D_SUBMIT_APP}" ]; then
            sr_json_format_fence_die "${_jf_who} has a non-string submit_app." "invalid_json" \
                "${_jf_next}" "${_jf_mode}"
        fi
        if sr_json_has_key "${_jf_body}" "submit_version" && [ -z "${SR_D_SUBMIT_VERSION}" ]; then
            sr_json_format_fence_die "${_jf_who} has a non-string submit_version." "invalid_json" \
                "${_jf_next}" "${_jf_mode}"
        fi
    else
        [ "${SR_D_VER}" = "1" ] || sr_json_format_fence_die "${_jf_who} is not schema_version 1." "schema_version" \
            "${_jf_next}" "${_jf_mode}"
        { [ "${SR_D_HAS_CMDS}" -eq 1 ] && [ -n "${SR_D_CMDS}" ]; } || sr_json_format_fence_die "${_jf_who} is an add/update request with no commands." "invalid_json" \
            "${_jf_next}" "${_jf_mode}"
        # Dest review warns (sr_dest_review_warn). Testers / convert still fail closed.
        if [ "${_jf_mode}" != "dest" ]; then
            [ -n "${SR_D_SUBMIT_APP}" ] || sr_json_format_fence_die "${_jf_who} has no submit_app (which CLI queued it)." "invalid_json" \
                "${_jf_next}" "${_jf_mode}"
            [ -n "${SR_D_SUBMIT_VERSION}" ] || sr_json_format_fence_die "${_jf_who} has no submit_version (which CLI version queued it)." "invalid_json" \
                "${_jf_next}" "${_jf_mode}"
        fi
    fi
}

# Dest Fence: well-known sudoer binary (requirement-well-known-sudoer-binary-fence).
# JSON-format Fence runs first. remove has no commands — skip.
sr_path_is_well_known() {
    _wp="$1"
    _skip_rp="${2:-0}"
    [ -n "${_wp}" ] || return 1
    case "${_wp}" in
        /*) ;;
        *) return 1 ;;
    esac
    case "${_wp}" in
        *'/../'*|*/..) return 1 ;;
    esac
    _wb="${_wp##*/}"
    [ -n "${_wb}" ] || return 1
    case "${_wb}" in
        python|python2|python3|pypy|pypy3|env|pip|pip3) return 1 ;;
        python3.*|python[0-9].*|python[0-9]|pypy[0-9]*) return 1 ;;
    esac
    case "${_wp}" in
        /bin/*|/sbin/*|/usr/bin/*|/usr/sbin/*|/usr/libexec/*|/usr/local/bin/*|/usr/local/sbin/*|/opt/gitlab/bin/*) ;;
        *) return 1 ;;
    esac
    if [ "${_skip_rp}" != "1" ] && [ -e "${_wp}" ] && command -v realpath >/dev/null 2>&1; then
        _wr=$(realpath "${_wp}" 2>/dev/null) || return 1
        if [ "${_wr}" != "${_wp}" ]; then
            sr_path_is_well_known "${_wr}" 1 || return 1
        fi
    fi
    return 0
}

sr_well_known_fence_die() {
    _wk_path="$1"
    _wk_mode="${2:-dest}"
    _wk_next="$3"
    _wk_msg="This grant names a command that is not a well-known system binary ('${_wk_path}'). A normal user can change a program under their own files and sudo would still run it."
    if [ "${_wk_mode}" = "dest" ]; then
        sr_die "${_wk_msg} Dest will not ask yes/no. Do not approve it." "untrusted_path" "${_wk_next}"
    fi
    sr_die "${_wk_msg} Do not convert or queue it." "untrusted_path" "${_wk_next}"
}

sr_cmds_require_well_known() {
    _cc="$1"
    _wk_mode="${2:-dest}"
    _wk_next="$3"
    [ -n "${_cc}" ] || return 0
    _wktf=$(util_mktemp)
    printf '%s' "${_cc}" >"${_wktf}"
    while IFS='|' read -r _wrn _wtg _wp _wa || [ -n "${_wp-}" ]; do
        [ -n "${_wp}" ] || continue
        if ! sr_path_is_well_known "${_wp}"; then
            rm -f "${_wktf}"
            sr_well_known_fence_die "${_wp}" "${_wk_mode}" "${_wk_next}"
        fi
    done <"${_wktf}"
    rm -f "${_wktf}"
}

sr_dest_fence_or_die() {
    _fp="$1"
    _fid="$2"
    _cmd=$(sr_operator_cmd)
    _next="${_cmd} add-sudoer-request --file request.json"
    if [ -L "${_fp}" ] || [ ! -f "${_fp}" ]; then
        sr_die "This waiting file is not a regular grant file (symlink or missing). Dest will not ask yes/no." "not_regular" \
            "${_next}"
    fi
    sr_parse_request_id "${_fid}"
    _body=$(cat "${_fp}")
    sr_json_format_fence_or_die "${_body}" "${_next}" "dest" "${_fid}"
}

# Dest review warn (not a dest Fence). Missing stamp / untrusted Cmnd: human still decides.
# ALIGNMENT: requirement-domain-sudoer-approval.md · requirement-well-known-sudoer-binary-fence.md
# INC-20260821-002
sr_dest_review_warn() {
    : "${SR_D_ACT:=}"
    : "${SR_D_SUBMIT_APP:=}"
    : "${SR_D_SUBMIT_VERSION:=}"
    : "${SR_D_CMDS:=}"
    : "${SR_ID_ACT:=}"
    _rw_act="${SR_D_ACT}"
    if [ -z "${_rw_act}" ]; then
        _rw_act="${SR_ID_ACT}"
    fi
    if [ "${_rw_act}" = "remove" ]; then
        return 0
    fi
    if [ -z "${SR_D_SUBMIT_APP}" ]; then
        out_warn "This waiting file has no submit_app (which CLI queued it). Dest will still ask yes/no."
    fi
    if [ -z "${SR_D_SUBMIT_VERSION}" ]; then
        out_warn "This waiting file has no submit_version (which CLI version queued it). Dest will still ask yes/no."
    fi
    [ -n "${SR_D_CMDS}" ] || return 0
    _wktf=$(util_mktemp)
    printf '%s' "${SR_D_CMDS}" >"${_wktf}"
    while IFS='|' read -r _wrn _wtg _wp _wa || [ -n "${_wp-}" ]; do
        [ -n "${_wp}" ] || continue
        if ! sr_path_is_well_known "${_wp}"; then
            out_warn "This grant names a command that is not a well-known system binary ('${_wp}'). A normal user can change a program under their own files and sudo would still run it. Dest will still ask yes/no."
        fi
    done <"${_wktf}"
    rm -f "${_wktf}"
}

sr_test_json_format() {
    _raw=$(sr_read_input)
    _cmd=$(sr_test_purpose_cmd)
    _next="${_cmd} test-json-format --file request.json"
    _fid=""
    if [ -n "${SR_FILE-}" ]; then
        _bn=$(basename -- "${SR_FILE}")
        case "${_bn}" in
            sudoer-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-*.json)
                _fid="${_bn}"
                ;;
        esac
    fi
    sr_json_format_fence_or_die "${_raw}" "${_next}" "test" "${_fid}"
    if [ "${JSON}" -eq 1 ]; then
        out_json "success" "JSON format is well-formed." \
            "command" "test-json-format" \
            "username" "${SR_D_USER}" \
            "service" "${SR_D_SVC}" \
            "action" "${SR_D_ACT}" \
            "kind" "${SR_D_KIND}" \
            "submit_app" "${SR_D_SUBMIT_APP}" \
            "submit_version" "${SR_D_SUBMIT_VERSION}" \
            "submit_by" "${SR_D_SUBMIT_BY}"
    else
        out_success "JSON format is well-formed."
    fi
}

sr_test_well_known_binary() {
    _raw=$(sr_read_input)
    _cmd=$(sr_test_purpose_cmd)
    _next="${_cmd} test-well-known-binary --file request.json"
    _fid=""
    if [ -n "${SR_FILE-}" ]; then
        _bn=$(basename -- "${SR_FILE}")
        case "${_bn}" in
            sudoer-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-*.json)
                _fid="${_bn}"
                ;;
        esac
    fi
    sr_json_format_fence_or_die "${_raw}" "${_cmd} test-json-format --file request.json" "test" "${_fid}"
    _wk_act="${SR_D_ACT:-}"
    if [ -n "${_fid}" ] && [ -z "${_wk_act}" ]; then
        _wk_act="${SR_ID_ACT}"
    fi
    if [ "${_wk_act}" = "remove" ]; then
        if [ "${JSON}" -eq 1 ]; then
            out_json "success" "remove has no commands; well-known binary fence does not apply." \
                "command" "test-well-known-binary" \
                "action" "remove"
        else
            out_success "remove has no commands; well-known binary fence does not apply."
        fi
        return 0
    fi
    sr_cmds_require_well_known "${SR_D_CMDS}" "test" "${_next}"
    if [ "${JSON}" -eq 1 ]; then
        out_json "success" "Command paths are well-known system binaries." \
            "command" "test-well-known-binary" \
            "username" "${SR_D_USER}" \
            "service" "${SR_D_SVC}" \
            "action" "${SR_D_ACT}"
    else
        out_success "Command paths are well-known system binaries."
    fi
}

sr_fence_test_fid() {
    _ft_bn=$(basename -- "${1-}")
    case "${_ft_bn}" in
        sudoer-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-*.json)
            printf '%s' "${_ft_bn}"
            ;;
        *)
            printf '%s' ""
            ;;
    esac
}

# Run the closed dest fence list (JSON format, then well-known binary). Dies on match.
sr_fence_test_apply() {
    _ft_body="$1"
    _ft_fid="$2"
    _cmd=$(sr_test_purpose_cmd)
    _next="${_cmd} fence-test --file request.json"
    sr_json_format_fence_or_die "${_ft_body}" "${_next}" "test" "${_ft_fid}"
    _ft_act="${SR_D_ACT:-}"
    if [ -n "${_ft_fid}" ] && [ -z "${_ft_act}" ]; then
        _ft_act="${SR_ID_ACT}"
    fi
    if [ "${_ft_act}" != "remove" ]; then
        sr_cmds_require_well_known "${SR_D_CMDS}" "test" "${_next}"
    fi
}

sr_fence_test() {
    _cmd=$(sr_test_purpose_cmd)
    if [ -n "${SR_DIR-}" ] && [ -n "${SR_FILE-}" ]; then
        sr_die "fence-test takes --file PATH or --dir DIR or stdin, not both --file and --dir." "xor_input" \
            "${_cmd} fence-test --file request.json"
    fi
    if [ -n "${SR_DIR-}" ]; then
        sr_fence_test_dir
        return 0
    fi
    if [ "${SR_EXPECT_MATCH:-0}" = "1" ]; then
        sr_die "--expect-match is only valid with --dir DIR." "xor_input" \
            "${_cmd} fence-test --dir tests/fixtures/fence-test/match --expect-match"
    fi
    _raw=$(sr_read_input)
    _fid=""
    if [ -n "${SR_FILE-}" ]; then
        _fid=$(sr_fence_test_fid "${SR_FILE}")
    fi
    sr_fence_test_apply "${_raw}" "${_fid}"
    if [ "${JSON}" -eq 1 ]; then
        out_json "success" "No dest fence matched." \
            "command" "fence-test" \
            "username" "${SR_D_USER}" \
            "service" "${SR_D_SVC}" \
            "action" "${SR_D_ACT}"
    else
        out_success "No dest fence matched."
    fi
}

sr_fence_test_dir() {
    _dir="${SR_DIR}"
    _cmd=$(sr_test_purpose_cmd)
    [ -n "${_dir}" ] || sr_die "fence-test --dir requires DIR." "xor_input" \
        "${_cmd} fence-test --dir tests/fixtures/fence-test/pass"
    [ -d "${_dir}" ] || sr_die "fence-test --dir is not a directory: ${_dir}" "not_found" \
        "${_cmd} fence-test --dir tests/fixtures/fence-test/pass"
    [ -L "${_dir}" ] && sr_die "fence-test refuses a symlink --dir: ${_dir}" "not_regular" \
        "${_cmd} fence-test --dir tests/fixtures/fence-test/pass"
    _expect="${SR_EXPECT_MATCH:-0}"
    _n=0
    _matched=0
    _passed=0
    for _fp in "${_dir}"/*.json; do
        [ -f "${_fp}" ] || continue
        [ -L "${_fp}" ] && continue
        _bn=$(basename -- "${_fp}")
        _n=$((_n + 1))
        if ( sr_fence_test_apply "$(cat "${_fp}")" "$(sr_fence_test_fid "${_fp}")" ); then
            _passed=$((_passed + 1))
            out_info "pass ${_bn}"
        else
            _matched=$((_matched + 1))
            out_info "fence-matched ${_bn}"
        fi
    done
    if [ "${_n}" -eq 0 ]; then
        sr_die "fence-test --dir has no regular .json files: ${_dir}" "not_found" \
            "${_cmd} fence-test --file request.json"
    fi
    if [ "${_expect}" = "1" ]; then
        if [ "${_passed}" -ne 0 ] || [ "${_matched}" -ne "${_n}" ]; then
            sr_die "fence-test --expect-match: ${_passed} of ${_n} files had no dest fence (want every file to match)." "invalid_json" \
                "${_cmd} fence-test --dir ${_dir} --expect-match"
        fi
        if [ "${JSON}" -eq 1 ]; then
            out_json "success" "fence-test: ${_n} files, all matched a dest fence." \
                "command" "fence-test" \
                "files" "${_n}" \
                "matched" "${_matched}" \
                "passed" "${_passed}" \
                "expect_match" "1"
        else
            out_success "fence-test: ${_n} files, all matched a dest fence."
        fi
        return 0
    fi
    if [ "${_matched}" -ne 0 ]; then
        sr_die "fence-test: ${_matched} of ${_n} files matched a dest fence." "invalid_json" \
            "${_cmd} fence-test --file request.json"
    fi
    if [ "${JSON}" -eq 1 ]; then
        out_json "success" "fence-test: ${_n} files, no dest fence matched." \
            "command" "fence-test" \
            "files" "${_n}" \
            "matched" "0" \
            "passed" "${_passed}"
    else
        out_success "fence-test: ${_n} files, no dest fence matched."
    fi
}

sr_approve() {
    sr_require_type1
    sr_require_queues
    sr_require_approver_views
    _id="${SR_OPERAND-}"
    [ -n "${_id}" ] || sr_die "approve requires request-id" "not_found"
    _in=$(sr_approver_dir request)
    _ok=$(sr_approver_dir approved)
    _path="${_in}/${_id}"
    [ -f "${_path}" ] || sr_die "not in request queue: ${_id}" "not_found"
    sr_dest_fence_or_die "${_path}" "${_id}"
    sr_dest_review_warn
    _priv=$(mktemp "${TMPDIR:-/tmp}/sr-apr.XXXXXX")
    if ! cp "${_path}" "${_priv}"; then
        rm -f "${_priv}"
        sr_die "cannot snapshot ${_id}" "authz"
    fi
    _body=$(cat "${_priv}")
    sr_json_decode_to_fields "${_body}"
    sr_parse_request_id "${_id}"
    _user="${SR_D_USER:-${SR_ID_USER}}"
    _svc="${SR_D_SVC:-${SR_ID_SVC}}"
    _act="${SR_D_ACT:-${SR_ID_ACT}}"
    if [ -n "${SR_D_ACT}" ] && [ "${SR_D_ACT}" != "${SR_ID_ACT}" ]; then
        rm -f "${_priv}"
        sr_die "This waiting file's name says ${SR_ID_ACT} but the JSON action is ${SR_D_ACT}. Dest will not ask yes/no. Do not approve it." "field_mismatch" \
            "$(sr_operator_cmd) add-sudoer-request --file request.json"
    fi
    [ -n "${_user}" ] || sr_die "username required" "invalid_json"
    [ -n "${_svc}" ] || sr_die "service required" "unknown_service"
    _dest=$(sr_grant_dest "${_user}" "${_svc}")
    sr_forbid_passwd_or_main_sudoers "${_dest}"
    sr_require_product_sudoers_d "${_dest}"
    _dest_dir=$(sr_sudoers_d_dir)
    if [ "${_act}" = "remove" ]; then
        if [ -f "${_dest}" ]; then
            if [ "${SUDOER_CLI_ALLOW_TEST_ROOTS:-0}" = "1" ]; then
                _bak="${_dest_dir}/.bak"
            else
                _bak="/etc/sudoers.bak"
            fi
            mkdir -p "${_bak}"
            mv "${_dest}" "${_bak}/$(basename "${_dest}").bak" 2>/dev/null || rm -f "${_dest}"
        fi
    else
        _txt=$(sr_render_sudoers "${SR_D_PURPOSE}" "${_user}" "${_act}" "${SR_D_CMDS}")
        sr_visudo_text "${_txt}"
        mkdir -p "${_dest_dir}"
        printf '%s\n' "${_txt}" >"${_dest}"
    fi
    sr_archive_validated "${_priv}" "${_ok}" "${_id}" "${_path}"
    if [ "${JSON}" -eq 1 ]; then
        out_json "success" "approved" "request_id" "${_id}" "dest" "${_dest}"
    else
        out_success "approved ${_id}"
    fi
}

sr_reject() {
    sr_require_type1
    sr_require_queues
    sr_require_approver_views
    _id="${SR_OPERAND-}"
    [ -n "${_id}" ] || sr_die "reject requires request-id" "not_found"
    _in=$(sr_approver_dir request)
    _no=$(sr_approver_dir rejected)
    _path="${_in}/${_id}"
    [ -f "${_path}" ] || sr_die "not in request queue: ${_id}" "not_found"
    sr_dest_fence_or_die "${_path}" "${_id}"
    _priv=$(mktemp "${TMPDIR:-/tmp}/sr-rej.XXXXXX")
    if ! cp "${_path}" "${_priv}"; then
        rm -f "${_priv}"
        sr_die "cannot snapshot ${_id}" "authz"
    fi
    sr_archive_validated "${_priv}" "${_no}" "${_id}" "${_path}"
    if [ "${JSON}" -eq 1 ]; then
        out_json "success" "rejected" "request_id" "${_id}"
    else
        out_success "rejected ${_id}"
    fi
}

# Interactive fence match: display already happened. Drain inbound → rejected
# without dest-write, without submit_by, without standalone reject re-validate.
# ALIGNMENT: requirement-incorrect-json-format.md · requirement-domain-sudoer-approval.md
sr_archive_fenced_rejected() {
    _fp="$1"
    _fid="$2"
    _no=$(sr_approver_dir rejected)
    _priv=$(mktemp "${TMPDIR:-/tmp}/sr-fence.XXXXXX")
    if ! cp "${_fp}" "${_priv}"; then
        rm -f "${_priv}"
        sr_die "cannot snapshot fenced ${_fid}" "authz"
    fi
    sr_archive_validated "${_priv}" "${_no}" "${_fid}" "${_fp}"
    if [ "${JSON}" -eq 1 ]; then
        out_json "success" "rejected" "request_id" "${_fid}" "reason" "fence"
    else
        out_success "rejected ${_fid}"
    fi
}

sr_interactive() {
    : "${TTY:=0}"
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${FORCE:=0}"
    if [ "${JSON}" -eq 1 ] || [ "${TTY}" -ne 1 ]; then
        sr_die "interactive needs a TTY (not --json)." "confirm_required"
    fi
    if [ "${QUIET}" -eq 1 ]; then
        sr_die "interactive needs a TTY without --quiet." "confirm_required"
    fi
    sr_require_type1
    sr_require_queues
    sr_require_approver_views
    _in=$(sr_approver_dir request)
    _ids=$(mktemp "${TMPDIR:-/tmp}/sr-int.XXXXXX")
    for _f in "${_in}"/sudoer-*.json; do
        [ -f "${_f}" ] || continue
        if [ -L "${_f}" ]; then
            continue
        fi
        _bn=$(basename "${_f}")
        case "${_bn}" in
            sudoer-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-*.json)
                printf '%s\n' "${_bn}" >>"${_ids}"
                ;;
        esac
    done
    if [ ! -s "${_ids}" ]; then
        rm -f "${_ids}"
        out_info "no pending requests"
        return 0
    fi
    _sorted=$(mktemp "${TMPDIR:-/tmp}/sr-int.XXXXXX")
    sort "${_ids}" >"${_sorted}"
    rm -f "${_ids}"
    # prompt_yes_no reads fd 0. Do not redirect the loop over stdin.
    while IFS= read -r _bn <&3; do
        [ -n "${_bn}" ] || continue
        out_info "Request ${_bn}"
        _orig_owner=$(sr_request_owner "${_in}/${_bn}")
        if [ "$(id -u)" -eq 0 ]; then
            sr_chown_request_to_lpu "${_in}/${_bn}"
        fi
        if ! ( sr_dest_fence_or_die "${_in}/${_bn}" "${_bn}" ); then
            if ! ( sr_archive_fenced_rejected "${_in}/${_bn}" "${_bn}" ); then
                out_error "could not move fenced ${_bn} to rejected; continuing"
            fi
            continue
        fi
        # Fence decode ran in a subshell. Parent must decode again (INC-20260821-002).
        _ibody=$(cat "${_in}/${_bn}")
        sr_json_decode_to_fields "${_ibody}"
        sr_dest_review_warn
        if [ -n "${_orig_owner}" ]; then
            sr_stamp_submit_by "${_in}/${_bn}" "${_orig_owner}"
        fi
        if [ -n "${SR_D_SUBMIT_APP-}" ] || [ -n "${SR_D_SUBMIT_VERSION-}" ]; then
            out_plain "queued by ${SR_D_SUBMIT_APP-} ${SR_D_SUBMIT_VERSION-}"
        fi
        SR_OPERAND="${_bn}"
        sr_show
        # One-off approval question (requirement-domain-sudoer-approval): yes=approve, no/Enter=reject.
        if prompt_yes_no "Approve this request"; then
            if ! ( SR_OPERAND="${_bn}"; sr_approve ); then
                out_error "approve failed for ${_bn}; continuing"
            fi
        else
            if ! ( SR_OPERAND="${_bn}"; sr_reject ); then
                out_error "reject failed for ${_bn}; continuing"
            fi
        fi
    done 3<"${_sorted}"
    rm -f "${_sorted}"
}

# LPU identity SSOT (requirement-least-privilege-user.md F1–F7).
lpu_defaults() {
    : "${LPU_USER:=sudoer-adm}"
    : "${LPU_UID:=1776}"
    : "${LPU_GID:=1776}"
    : "${LPU_SHELL:=/bin/bash}"
    : "${LPU_HOME:=/etc/sudoer-adm}"
    : "${LPU_HOOK_BEGIN:=# BEGIN sudoer-cli login hook}"
    : "${LPU_HOOK_END:=# END sudoer-cli login hook}"
}

lpu_find_bin() {
    if command -v "$1" >/dev/null 2>&1; then
        command -v "$1"
        return 0
    fi
    if [ -x "/usr/sbin/$1" ]; then
        printf '%s' "/usr/sbin/$1"
        return 0
    fi
    return 1
}

# Mix model: account tools run as `sudo <tool>` (password OK). Never `sudo -n`.
# After `sudo {{APP}} setup` we are already euid 0 — util_sudo skips nested sudo.
# useradd/userdel MUST NOT appear in F6 / print-sudoers (FORB-07).
lpu_sudo() {
    if [ "$(id -u)" -ne 0 ] && ! command -v sudo >/dev/null 2>&1; then
        _cmd=$(sr_operator_cmd)
        sr_die "need root to run: $*" "authz" "sudo ${_cmd} setup"
    fi
    util_sudo "$@"
}

lpu_collision_check() {
    lpu_defaults
    _pw=$(getent passwd "${LPU_UID}" 2>/dev/null || true)
    if [ -n "${_pw}" ]; then
        _n=$(printf '%s' "${_pw}" | cut -d: -f1)
        _h=$(printf '%s' "${_pw}" | cut -d: -f6)
        if [ "${_n}" != "${LPU_USER}" ]; then
            sr_die "cannot create ${LPU_USER}: UID ${LPU_UID} is already account ${_n}." "authz" \
                "getent passwd ${LPU_UID}    (will not steal that UID)"
        fi
        if [ "${_h}" != "${LPU_HOME}" ]; then
            sr_die "cannot create ${LPU_USER}: UID ${LPU_UID} home is ${_h}, expected ${LPU_HOME}." "authz" \
                "getent passwd ${LPU_UID}"
        fi
    fi
    _pw=$(getent passwd "${LPU_USER}" 2>/dev/null || true)
    if [ -n "${_pw}" ]; then
        _u=$(printf '%s' "${_pw}" | cut -d: -f3)
        _g=$(printf '%s' "${_pw}" | cut -d: -f4)
        _h=$(printf '%s' "${_pw}" | cut -d: -f6)
        if [ "${_u}" != "${LPU_UID}" ] || [ "${_g}" != "${LPU_GID}" ]; then
            sr_die "${LPU_USER} already exists as ${_u}:${_g}, expected ${LPU_UID}:${LPU_GID}. Refusing to rewrite a live identity." "authz" \
                "id ${LPU_USER}"
        fi
        if [ "${_h}" != "${LPU_HOME}" ]; then
            sr_die "${LPU_USER} home is ${_h}, expected ${LPU_HOME}. Refusing to move a live home." "authz" \
                "getent passwd ${LPU_USER}"
        fi
    fi
    _gr=$(getent group "${LPU_GID}" 2>/dev/null || true)
    if [ -n "${_gr}" ]; then
        _n=$(printf '%s' "${_gr}" | cut -d: -f1)
        if [ "${_n}" != "${LPU_USER}" ]; then
            sr_die "cannot create group ${LPU_USER}: GID ${LPU_GID} is already ${_n}." "authz" \
                "getent group ${LPU_GID}"
        fi
    fi
    _gr=$(getent group "${LPU_USER}" 2>/dev/null || true)
    if [ -n "${_gr}" ]; then
        _g=$(printf '%s' "${_gr}" | cut -d: -f3)
        if [ "${_g}" != "${LPU_GID}" ]; then
            sr_die "group ${LPU_USER} exists as gid ${_g}, expected ${LPU_GID}. Refusing to rewrite it." "authz" \
                "getent group ${LPU_USER}"
        fi
    fi
}

lpu_ensure_global_bin() {
    _gb="${GLOBAL_BIN:-/usr/local/bin}"
    LPU_GLOBAL_BIN="${_gb}/${APP_NAME}"
    _src=$(util_resolve_running_path)
    if [ -x "${LPU_GLOBAL_BIN}" ]; then
        _have=$(grep '^VERSION="' "${LPU_GLOBAL_BIN}" 2>/dev/null | head -n1 | cut -d'"' -f2)
        _want=""
        if [ -n "${_src}" ] && [ -f "${_src}" ]; then
            _want=$(grep '^VERSION="' "${_src}" 2>/dev/null | head -n1 | cut -d'"' -f2)
        fi
        if [ -n "${_have}" ] && [ -n "${_want}" ] && [ "${_have}" = "${_want}" ]; then
            return 0
        fi
        # Stale global binary. Replace from this ship unit so the login hook matches this VERSION.
    fi
    if [ -z "${_src}" ] || [ ! -f "${_src}" ]; then
        _run=$(util_resolve_running_path)
        _hint="sudo sh ${_run:-<path-to-src/${APP_NAME}>} install"
        sr_die "production F6 needs ${LPU_GLOBAL_BIN}, and it is missing. Cannot resolve this ship unit to copy there." "authz" \
            "${_hint}"
    fi
    mkdir -p "${_gb}" || sr_die "cannot create ${_gb}" "authz"
    _stage=$(mktemp "${TMPDIR:-/tmp}/${APP_NAME}.lpu.XXXXXX") || sr_die "mktemp failed" "authz"
    if ! cp "${_src}" "${_stage}"; then
        rm -f "${_stage}"
        sr_die "cannot stage global binary" "authz"
    fi
    util_chmod 0755 "${_stage}" || true
    if ! mv -f "${_stage}" "${LPU_GLOBAL_BIN}"; then
        rm -f "${_stage}"
        sr_die "cannot install ${LPU_GLOBAL_BIN}" "authz"
    fi
    util_chmod 0755 "${LPU_GLOBAL_BIN}" || true
    if [ ! -x "${LPU_GLOBAL_BIN}" ]; then
        sr_die "installed ${LPU_GLOBAL_BIN} is not executable" "authz"
    fi
    out_info "Installed global binary ${LPU_GLOBAL_BIN} (required for F6)"
}

lpu_f6_text() {
    lpu_defaults
    _gb="${GLOBAL_BIN:-/usr/local/bin}"
    printf '# %s F6 Table A — production global binary\n%s ALL=(root) NOPASSWD: %s/%s\n' \
        "${APP_NAME}" "${LPU_USER}" "${_gb}" "${APP_NAME}"
}

lpu_f6_path() {
    lpu_defaults
    printf '%s/%s' "$(sr_sudoers_d_dir)" "${LPU_USER}"
}

lpu_install_f6() {
    lpu_defaults
    _txt=$(lpu_f6_text)
    sr_visudo_text "${_txt}"
    _dest=$(lpu_f6_path)
    sr_forbid_passwd_or_main_sudoers "${_dest}"
    sr_require_product_sudoers_d "${_dest}"
    _dir=$(sr_sudoers_d_dir)
    mkdir -p "${_dir}" || sr_die "cannot create ${_dir}" "authz"
    if [ -f "${_dest}" ]; then
        if [ "${SUDOER_CLI_ALLOW_TEST_ROOTS:-0}" = "1" ]; then
            _bak="${_dir}/.bak"
        else
            _bak="/etc/sudoers.bak"
        fi
        mkdir -p "${_bak}" 2>/dev/null || true
        cp "${_dest}" "${_bak}/${LPU_USER}.bak" 2>/dev/null || true
    fi
    _tmp=$(mktemp "${TMPDIR:-/tmp}/${APP_NAME}.f6.XXXXXX") || sr_die "mktemp failed" "visudo_fail"
    printf '%s\n' "${_txt}" >"${_tmp}"
    if [ "${SUDOER_CLI_ALLOW_TEST_ROOTS:-0}" = "1" ]; then
        install -m 0440 "${_tmp}" "${_dest}" || { rm -f "${_tmp}"; sr_die "cannot install F6 ${_dest}" "authz"; }
    else
        install -m 0440 -o root -g root "${_tmp}" "${_dest}" || { rm -f "${_tmp}"; sr_die "cannot install F6 ${_dest}" "authz"; }
    fi
    rm -f "${_tmp}"
}

lpu_link_home_queue() {
    _link="$1"
    _target="$2"
    if [ -L "${_link}" ]; then
        if ! ln -sfn "${_target}" "${_link}"; then
            sr_die "cannot refresh queue symlink ${_link}" "authz"
        fi
        return 0
    fi
    if [ -d "${_link}" ]; then
        if ! cp -a "${_link}/." "${_target}/"; then
            sr_die "cannot migrate ${_link} to ${_target}" "authz"
        fi
        rm -rf "${_link}"
    fi
    if [ -e "${_link}" ]; then
        sr_die "cannot place queue symlink ${_link}" "authz"
    fi
    if ! ln -sfn "${_target}" "${_link}"; then
        sr_die "cannot create queue symlink ${_link}" "authz"
    fi
}

lpu_mkdir_f5() {
    lpu_defaults
    lpu_resolve_home
    sr_resolve_queues
    _pub="${SUDOER_PUBLIC_QUEUE_ROOT}"
    mkdir -p "${_pub}/sudoer-request" "${_pub}/sudoer-approved" "${_pub}/sudoer-rejected" \
        || sr_die "cannot create public queues under ${_pub}" "authz"
    util_chmod 0755 "${_pub}" || sr_die "cannot chmod public queue root" "authz"
    util_chmod 3773 "${_pub}/sudoer-request" || sr_die "cannot chmod request queue" "authz"
    util_chmod 0700 "${_pub}/sudoer-approved" || sr_die "cannot chmod approved queue" "authz"
    util_chmod 0700 "${_pub}/sudoer-rejected" || sr_die "cannot chmod rejected queue" "authz"
    if [ -d "${LPU_HOME}/sudoer-approving" ] && [ ! -L "${LPU_HOME}/sudoer-approving" ]; then
        if ! cp -a "${LPU_HOME}/sudoer-approving/." "${_pub}/sudoer-request/"; then
            sr_die "cannot migrate old inbound queue" "authz"
        fi
        rm -rf "${LPU_HOME}/sudoer-approving"
    fi
    lpu_link_home_queue "${LPU_HOME}/sudoer-request" "${_pub}/sudoer-request"
    lpu_link_home_queue "${LPU_HOME}/sudoer-approved" "${_pub}/sudoer-approved"
    lpu_link_home_queue "${LPU_HOME}/sudoer-rejected" "${_pub}/sudoer-rejected"
    if getent passwd "${LPU_USER}" >/dev/null 2>&1; then
        if ! chown "${LPU_USER}:${LPU_USER}" "${LPU_HOME}" \
            "${_pub}" "${_pub}/sudoer-request" "${_pub}/sudoer-approved" "${_pub}/sudoer-rejected"; then
            sr_die "cannot chown LPU home/queues" "authz"
        fi
        util_chmod 0751 "${LPU_HOME}" || true
    fi
}

# After create or mktemp+mv, the dest must belong to the LPU (not the elevated invoker).
lpu_own_user_rc() {
    lpu_defaults
    _of="${1:-}"
    [ -n "${_of}" ] && [ -f "${_of}" ] || return 0
    util_chmod 0644 "${_of}" || sr_die "cannot chmod ${_of} for ${LPU_USER}" "authz"
    if getent passwd "${LPU_USER}" >/dev/null 2>&1; then
        chown "${LPU_USER}:${LPU_USER}" "${_of}" || sr_die "cannot chown ${_of} to ${LPU_USER}:${LPU_USER}" "authz"
    fi
}

lpu_hook_text() {
    lpu_defaults
    _bin="${GLOBAL_BIN:-/usr/local/bin}/${APP_NAME}"
    printf '%s\n' "${LPU_HOOK_BEGIN}"
    printf '%s\n' "if [ -z \"\${SUDOER_CLI_HOOK_RAN-}\" ] \\"
    printf '%s\n' "  && [ -n \"\${PS1-}\" ] \\"
    printf '%s\n' "  && [ -t 0 ] && [ -t 1 ] \\"   # lpu-hook-rc (not CLI TTY SSOT)
    printf '%s\n' "  && case \$- in *i*) true ;; *) false ;; esac \\"
    printf '%s\n' "  && [ \"\$(id -un)\" = \"${LPU_USER}\" ] \\"
    printf '%s\n' "  && [ -z \"\${SSH_ORIGINAL_COMMAND-}\" ]; then"
    printf '%s\n' "  SUDOER_CLI_HOOK_RAN=1"
    printf '%s\n' "  export SUDOER_CLI_HOOK_RAN"
    printf '%s\n' "  sudo -n ${_bin} interactive \\"   # lpu-hook-rc (specified F6 -n)
    printf '%s\n' "    || printf '%s\\n' \"${APP_NAME}: interactive hook skipped\" >&2"
    printf '%s\n' "fi"
    printf '%s\n' "${LPU_HOOK_END}"
}

lpu_hook_strip() {
    lpu_defaults
    _hf="$1"
    [ -f "${_hf}" ] || return 0
    _ht=$(mktemp "${TMPDIR:-/tmp}/${APP_NAME}.hook.XXXXXX") || sr_die "mktemp failed" "authz"
    awk -v b="${LPU_HOOK_BEGIN}" -v e="${LPU_HOOK_END}" '
        $0 == b { skip=1; next }
        $0 == e { skip=0; next }
        skip { next }
        { print }
    ' "${_hf}" >"${_ht}" || { rm -f "${_ht}"; sr_die "cannot rewrite ${_hf}" "authz"; }
    mv -f "${_ht}" "${_hf}"
    lpu_own_user_rc "${_hf}"
}

lpu_hook_apply() {
    lpu_defaults
    _hf="$1"
    if [ ! -f "${_hf}" ]; then
        : >"${_hf}" || sr_die "cannot create ${_hf}" "authz"
    fi
    lpu_hook_strip "${_hf}"
    printf '\n%s\n' "$(lpu_hook_text)" >>"${_hf}" || sr_die "cannot write hook ${_hf}" "authz"
    lpu_own_user_rc "${_hf}"
}

lpu_profile_sources_bashrc() {
    [ -f "$1" ] || return 1
    grep -q '\.bashrc' "$1" 2>/dev/null
}

lpu_profile_text() {
    printf '%s\n' \
        "# BEGIN sudoer-cli profile source-bashrc" \
        "# Created so a bash login shell sources interactive rc (hook lives in .bashrc)." \
        "if [ -n \"\${BASH_VERSION:-}\" ]; then" \
        "    if [ -f \"\${HOME}/.bashrc\" ]; then" \
        "        . \"\${HOME}/.bashrc\"" \
        "    fi" \
        "fi" \
        "# END sudoer-cli profile source-bashrc"
}

# Login shells source .profile, not .bashrc. Missing .profile = hook never fires.
lpu_ensure_profile() {
    lpu_defaults
    _pr="${LPU_HOME}/.profile"
    if [ -f "${_pr}" ]; then
        lpu_own_user_rc "${_pr}"
        return 0
    fi
    mkdir -p "${LPU_HOME}" || sr_die "cannot create ${LPU_HOME}" "authz"
    _ptmp=$(mktemp "${LPU_HOME}/.profile.sudoer-cli.XXXXXX") || sr_die "cannot stage .profile" "authz"
    lpu_profile_text >"${_ptmp}" || { rm -f "${_ptmp}"; sr_die "cannot write .profile" "authz"; }
    util_chmod 0644 "${_ptmp}" || { rm -f "${_ptmp}"; sr_die "cannot chmod staged .profile" "authz"; }
    if [ ! -f "${_pr}" ]; then
        mv -f "${_ptmp}" "${_pr}" || { rm -f "${_ptmp}"; sr_die "cannot create ${_pr}" "authz"; }
    else
        rm -f "${_ptmp}"
    fi
    lpu_own_user_rc "${_pr}"
}

lpu_install_hook() {
    lpu_defaults
    lpu_hook_apply "${LPU_HOME}/.bashrc"
    lpu_ensure_profile
    _pr="${LPU_HOME}/.profile"
    if [ -f "${_pr}" ]; then
        if lpu_profile_sources_bashrc "${_pr}"; then
            lpu_hook_strip "${_pr}"
        else
            lpu_hook_apply "${_pr}"
        fi
    fi
}

lpu_create_account() {
    lpu_defaults
    _groupadd=$(lpu_find_bin groupadd) || sr_die "groupadd is not installed (need /usr/sbin/groupadd)." "authz" \
        "which groupadd || ls /usr/sbin/groupadd"
    _useradd=$(lpu_find_bin useradd) || sr_die "useradd is not installed (need /usr/sbin/useradd)." "authz" \
        "which useradd || ls /usr/sbin/useradd"
    mkdir -p "${LPU_HOME}" || sr_die "cannot create home ${LPU_HOME}." "authz" \
        "ls -ld $(dirname "${LPU_HOME}")"
    if ! getent group "${LPU_USER}" >/dev/null 2>&1; then
        lpu_sudo "${_groupadd}" -g "${LPU_GID}" "${LPU_USER}" || sr_die "groupadd ${LPU_USER} (gid ${LPU_GID}) failed." "authz" \
            "getent group ${LPU_GID}; getent group ${LPU_USER}"
    fi
    if ! getent passwd "${LPU_USER}" >/dev/null 2>&1; then
        # -M: we already created ${LPU_HOME} (under /etc). -m + HOME=/home can refuse that path.
        lpu_sudo "${_useradd}" -u "${LPU_UID}" -g "${LPU_GID}" -d "${LPU_HOME}" -s "${LPU_SHELL}" -M "${LPU_USER}" \
            || sr_die "useradd ${LPU_USER} (uid ${LPU_UID}) failed." "authz" \
            "getent passwd ${LPU_UID}; getent passwd ${LPU_USER}"
    fi
    util_chmod 0751 "${LPU_HOME}" || true
    chown "${LPU_USER}:${LPU_USER}" "${LPU_HOME}" || sr_die "cannot chown ${LPU_HOME} to ${LPU_USER}." "authz" \
        "ls -ld ${LPU_HOME}; id ${LPU_USER}"
}

lpu_archive_queues() {
    lpu_defaults
    sr_resolve_queues
    _day=$(date +%Y%m%d)
    _base="/var/backups/${APP_NAME}"
    if [ "${SUDOER_CLI_ALLOW_TEST_ROOTS:-0}" = "1" ]; then
        _base="${LPU_HOME}/.lpu-archive"
    fi
    _n=1
    while [ -e "${_base}/${_day}-${_n}" ]; do
        _n=$((_n + 1))
    done
    _arch="${_base}/${_day}-${_n}"
    mkdir -p "${_arch}" || sr_die "cannot create archive ${_arch}" "authz"
    for _q in "${SUDOER_QUEUE_REQUEST}" "${SUDOER_QUEUE_APPROVED}" "${SUDOER_QUEUE_REJECTED}"; do
        if [ -d "${_q}" ]; then
            cp -a "${_q}" "${_arch}/" || sr_die "cannot archive ${_q}" "authz"
        fi
    done
    printf '%s' "${_arch}"
}

# Remove only the three known public queue children, then rmdir the root if empty.
lpu_remove_public_queues() {
    lpu_defaults
    lpu_resolve_home
    sr_resolve_queues
    _pub="${SUDOER_PUBLIC_QUEUE_ROOT}"
    [ -n "${_pub}" ] || return 0
    for _n in sudoer-request sudoer-approved sudoer-rejected; do
        _p="${_pub}/${_n}"
        if [ -e "${_p}" ] || [ -L "${_p}" ]; then
            rm -rf "${_p}"
        fi
    done
    if [ -d "${_pub}" ]; then
        rmdir "${_pub}" 2>/dev/null || true
    fi
}

lpu_setup() {
    sr_require_type1_bootstrap
    if [ "${SR_UNINSTALL:-0}" -eq 1 ]; then
        lpu_remove
        return 0
    fi
    lpu_defaults
    lpu_collision_check
    LPU_GLOBAL_BIN="${GLOBAL_BIN:-/usr/local/bin}/${APP_NAME}"
    lpu_ensure_global_bin
    lpu_create_account
    lpu_mkdir_f5
    lpu_install_f6
    lpu_install_hook
    if [ "${JSON}" -eq 1 ]; then
        out_json "success" "lpu ready" \
            "user" "${LPU_USER}" \
            "uid" "${LPU_UID}" \
            "home" "${LPU_HOME}" \
            "f6" "$(lpu_f6_path)" \
            "binary" "${LPU_GLOBAL_BIN}"
    else
        out_success "LPU ${LPU_USER} ready (uid ${LPU_UID}, home ${LPU_HOME})"
        out_info "F6 $(lpu_f6_path)"
        out_info "Global binary ${LPU_GLOBAL_BIN}"
        _cmd=$(sr_operator_cmd)
        out_info "Next: as yourself (not ${LPU_USER}), ${_cmd} add-sudoer-request --file request.json"
        out_info "Then this sudo is the approval: sudo ${_cmd} interactive"
    fi
}

lpu_remove() {
    sr_require_type1_bootstrap
    lpu_defaults
    lpu_resolve_home
    if [ "${FORCE:-0}" -eq 0 ]; then
        if [ "${JSON}" -eq 1 ] || [ "${QUIET}" -eq 1 ] || [ "${TTY}" -eq 0 ]; then
            _cmd=$(sr_operator_cmd)
            sr_die "remove-lpu needs a yes/no on a TTY (this run is non-interactive)." "confirm_required" \
                "sudo ${_cmd} remove-lpu --force"
        fi
        if ! prompt_yes_no "Remove LPU ${LPU_USER}? Live grants stay."; then
            out_info "remove-lpu cancelled"
            return 0
        fi
    fi
    out_warn "Live service-user grants stay (no --purge-grants in v1)"
    if [ -f "${LPU_HOME}/.bashrc" ]; then
        lpu_hook_strip "${LPU_HOME}/.bashrc"
    fi
    if [ -f "${LPU_HOME}/.profile" ]; then
        lpu_hook_strip "${LPU_HOME}/.profile"
    fi
    _arch=""
    if [ "${SR_PURGE_QUEUES:-0}" -ne 1 ]; then
        _arch=$(lpu_archive_queues)
    fi
    lpu_remove_public_queues
    _dest=$(lpu_f6_path)
    sr_forbid_passwd_or_main_sudoers "${_dest}"
    sr_require_product_sudoers_d "${_dest}"
    if [ -f "${_dest}" ]; then
        if [ "${SUDOER_CLI_ALLOW_TEST_ROOTS:-0}" = "1" ]; then
            _bak="$(dirname "${_dest}")/.bak"
        else
            _bak="/etc/sudoers.bak"
        fi
        mkdir -p "${_bak}" 2>/dev/null || true
        mv "${_dest}" "${_bak}/${LPU_USER}.bak" 2>/dev/null || rm -f "${_dest}"
    fi
    if getent passwd "${LPU_USER}" >/dev/null 2>&1; then
        _userdel=$(lpu_find_bin userdel) || sr_die "userdel is not installed (need /usr/sbin/userdel)." "authz" \
            "which userdel || ls /usr/sbin/userdel"
        lpu_sudo "${_userdel}" -r "${LPU_USER}" || sr_die "sudo userdel -r ${LPU_USER} failed. Account may still exist." "authz" \
            "id ${LPU_USER}; getent passwd ${LPU_USER}"
    fi
    if getent group "${LPU_USER}" >/dev/null 2>&1; then
        _groupdel=$(lpu_find_bin groupdel) || true
        if [ -n "${_groupdel}" ]; then
            lpu_sudo "${_groupdel}" "${LPU_USER}" 2>/dev/null || true
        fi
    fi
    if [ "${JSON}" -eq 1 ]; then
        out_json "success" "lpu removed" "user" "${LPU_USER}" "archive" "${_arch}"
    else
        out_success "Removed LPU ${LPU_USER}"
        if [ -n "${_arch}" ]; then
            out_info "Queued archive: ${_arch}"
        fi
    fi
}

# =============================================================================
# app_help() - Usage (Type 0 lifecycle + routed domain)
