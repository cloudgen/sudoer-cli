# =============================================================================
# app_main_menu() - TTY menu (verb menu / main; empty argv is Type O install-ensure)
# =============================================================================
#
# GENERAL PURPOSE:
# Interactive (TTY=1): ignore --json, draw the numbered list, read a choice
# in the current shell (PROMPT_ASK_VALUE; MUST NOT $() prompt_ask), run that
# handler. Invalid choice: out_error, reprint this layer, re-prompt
# (MUST NOT out_die). Nested numbered submenu (language board) uses the same
# retry on that layer. Empty line / EOF leaves this layer without spinning.
# Non-interactive: help (human or JSON). MUST NOT hang. MUST NOT swallow
# help under --quiet.
#
# ALIGNMENT:
# - requirement-shell-cli-default-interaction.md
# - requirement-shell-cli-zero-arguments.md (empty argv is not this path)
# - requirement-shell-prompt.md (PROMPT_ASK_VALUE)
#
# Last updated: 2026-10-02
# =============================================================================
app_main_menu() {
    : "${TTY:=0}"
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${PROMPT_ASK_VALUE:=}"

    if [ "${TTY}" -ne 1 ]; then
        if [ "${JSON}" -eq 0 ]; then
            QUIET=0
        fi
        app_help
        return 0
    fi

    # Interactive menu ignores --json (case 3). Restore after a valid pick or Exit.
    local _menu_json="${JSON}"
    local _menu_quiet="${QUIET}"
    local _choice=""
    JSON=0
    QUIET=0

    # Invalid choice retries this layer (out_error + reprint; MUST NOT out_die).
    # Nested numbered submenu (language board) uses the same retry on that layer.
    while true; do
        app_main_menu_print
        # WARNING — do-not-capture-read (PP-A-22)
        # MUST NOT _choice=$(prompt_ask …) / $() / backticks. Body of prompt_ask contains read.
        prompt_ask "$(app_menu_text choice_label)" ""
        _choice="${PROMPT_ASK_VALUE}"
        _choice=$(printf '%s' "${_choice}" | tr -d '\r')
        _choice=$(printf '%s' "${_choice}" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

        case "${_choice}" in
            1|sudoers-to-json) COMMAND=sudoers-to-json; break ;;
            2|json-to-sudoers) COMMAND=json-to-sudoers; break ;;
            3|print-sudoers) COMMAND=print-sudoers; break ;;
            4|print-sudoers-install-script) COMMAND=print-sudoers-install-script; break ;;
            5|languages|language|語言|语言|idiomas|idioma|langues|langue|Sprachen|Sprache|言語|언어|لغات|لغة|языки|язык|talen|taal|γλώσσες|γλώσσα)
                app_cmd_menu_language
                continue
                ;;
            6|add-sudoer-request) COMMAND=add-sudoer-request; break ;;
            7|update-sudoer-request) COMMAND=update-sudoer-request; break ;;
            8|remove-sudoer-request) COMMAND=remove-sudoer-request; break ;;
            9|list-approving) COMMAND=list-approving; break ;;
            10|list-approved) COMMAND=list-approved; break ;;
            11|list-rejected) COMMAND=list-rejected; break ;;
            12|show) COMMAND=show; break ;;
            13|remove-lpu) COMMAND=remove-lpu; break ;;
            14|approve) COMMAND=approve; break ;;
            15|reject) COMMAND=reject; break ;;
            16|interactive) COMMAND=interactive; break ;;
            99|exit|quit|Exit|"")
                JSON="${_menu_json}"
                QUIET="${_menu_quiet}"
                return 0
                ;;
            *)
                out_error "$(app_menu_text unknown_front "${_choice}")"
                continue
                ;;
        esac
    done

    JSON="${_menu_json}"
    QUIET="${_menu_quiet}"
    app_run_command
}

# =============================================================================
# app_run_command() - Dispatch COMMAND to the live handler
# =============================================================================
#
# GENERAL PURPOSE:
# Single case for the live dispatcher. app_main parses flags then calls this.
# app_main_menu sets COMMAND from a numbered choice then calls this.
#
# ALIGNMENT:
# - requirement-shell-cli-interface.md
# - requirement-shell-cli-default-interaction.md
#
# Last updated: 2026-09-03
# =============================================================================
app_run_command() {
    : "${COMMAND:=help}"
    case "${COMMAND}" in
        version)      app_version ;;
        about)        app_about ;;
        install)      inst_perform_install ;;
        version-check) ver_check ;;
        self-update)  inst_self_update ;;
        self-uninstall) inst_self_uninstall ;;
        menu|main)    app_main_menu ;;
        sudoers-to-json) sr_sudoers_to_json ;;
        json-to-sudoers) sr_json_to_sudoers ;;
        test-json-format) sr_test_json_format ;;
        test-well-known-binary) sr_test_well_known_binary ;;
        fence-test) sr_fence_test ;;
        rc-test)
            # shellcheck disable=SC2086
            set -- ${RC_TEST_OPERANDS}
            path_rc_test "$@"
            ;;
        print-sudoers) sr_print_sudoers ;;
        print-sudoers-install-script) sr_print_sudoers_install_script ;;
        add-sudoer-request)    sr_submit add ;;
        update-sudoer-request) sr_submit update ;;
        remove-sudoer-request) sr_submit remove ;;
        list-approving)  sr_list approving ;;
        list-approved)   sr_list approved ;;
        list-rejected)   sr_list rejected ;;
        show)            sr_show ;;
        approve)         sr_approve ;;
        reject)          sr_reject ;;
        interactive)     sr_interactive ;;
        setup)           lpu_setup ;;
        remove-lpu)      lpu_remove ;;
        help|*)          app_help ;;
    esac
}

