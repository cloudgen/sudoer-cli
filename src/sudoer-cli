path_add_shell() {
    local added=0
    local shell_config="N/A"
    : "${HOME:=/tmp}"
    : "${BASHRC:=${HOME}/.bashrc}"
    : "${ZSHRC:=${HOME}/.zshrc}"
    : "${FISH_CONFIG:=${HOME}/.config/fish/config.fish}"
    : "${PROFILE:=${HOME}/.profile}"

    if path_add_bashrc; then
        added=1
        shell_config="${BASHRC}"
    fi

