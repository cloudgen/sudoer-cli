    out_info "Examples:"
    out_plain "  ${APP_NAME} install"
    out_plain "  sudo ${APP_NAME} install          # global (multi-user hosts)"
    out_plain "  ${APP_NAME} version"
    out_plain "  ${APP_NAME} about"
